{%- comment -%}
  Product card.
  Accepts:
  - product {Object} product, or blank to render a placeholder
  - placeholder_index {Number} index for placeholder images
  - lazy {Boolean} lazy-load images (default true)
  - sizes {String} image sizes attribute
  - section_id {String}

  Badges: tag a product "badge:New" or "badge:Bestseller" to show a custom label.
  Ratings: shown when a reviews app fills the standard reviews.rating metafield.
{%- endcomment -%}
{%- liquid
  case settings.card_image_ratio
    when 'portrait'
      assign ratio_class = 'media--portrait'
    when 'square'
      assign ratio_class = 'media--square'
    else
      assign ratio_class = ''
  endcase

  assign loading = 'lazy'
  assign priority = 'auto'
  if lazy == false
    assign loading = 'eager'
    assign priority = 'high'
  endif
  assign img_sizes = sizes | default: '(min-width: 990px) 25vw, (min-width: 750px) 33vw, 50vw'
  assign fit = settings.card_image_fit | default: 'cover'
-%}

{%- assign card_tint = product.metafields.custom.tint.value | default: product.metafields.custom.tint -%}
<div class="card card--fit-{{ fit }}{% if card_tint != blank %} card--tinted{% endif %}"{% if card_tint != blank %} style="--tint: {{ card_tint }};"{% endif %} data-reveal>
  {%- if product != blank -%}
    {%- liquid
      assign featured = product.featured_media
      assign custom_badge = ''
      for tag in product.tags
        assign tag_lower = tag | downcase
        if tag_lower contains 'badge:'
          assign custom_badge = tag | split: ':' | last | strip
          break
        endif
      endfor
      assign on_sale = false
      if product.compare_at_price > product.price
        assign on_sale = true
        assign saving = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round
      endif
      assign show_add = false
      if settings.card_show_quick_add and product.available
        assign show_add = true
      endif
    -%}
    <div
      class="card__media media {{ ratio_class }}"
      {% if ratio_class == '' and featured %}
        style="aspect-ratio: {{ featured.aspect_ratio }};"
      {% elsif ratio_class == '' %}
        style="aspect-ratio: 1;"
      {% endif %}
    >
      {%- if featured -%}
        {{
          featured
          | image_url: width: 1200
          | image_tag:
            widths: '240, 360, 480, 600, 800, 1000, 1200',
            sizes: img_sizes,
            loading: loading,
            fetchpriority: priority,
            alt: featured.alt | default: product.title,
            class: 'card__image'
        }}
        {%- if settings.card_show_secondary_image and product.media[1] -%}
          {{
            product.media[1]
            | image_url: width: 1200
            | image_tag:
              widths: '240, 360, 480, 600, 800, 1000, 1200',
              sizes: img_sizes,
              loading: 'lazy',
              alt: '',
              class: 'card__image card__image--secondary'
          }}
        {%- endif -%}
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}

      <div class="card__badges">
        {%- if product.available == false -%}
          <span class="badge badge--sold-out">{{ 'products.product.sold_out' | t }}</span>
        {%- elsif on_sale -%}
          <span class="badge badge--sale">
            <span aria-hidden="true">−{{ saving }}%</span>
            <span class="visually-hidden">{{ 'products.product.on_sale' | t }}</span>
          </span>
        {%- endif -%}
        {%- if custom_badge != blank -%}
          <span class="badge badge--custom">{{ custom_badge | escape }}</span>
        {%- endif -%}
      </div>

      {%- if show_add or settings.card_show_quick_view -%}
        <div class="card__actions">
          {%- if show_add -%}
            {%- if product.has_only_default_variant -%}
              <product-form class="card__action-form">
                {%- form 'product', product, id: nil -%}
                  <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                  <button
                    type="submit"
                    name="add"
                    class="card__action card__action--primary"
                    aria-label="{{ 'products.product.add_to_cart_named' | t: title: product.title | escape }}"
                  >
                    {% render 'icon', icon: 'plus' %}
                    <span class="button__label card__action-label">{{ 'products.product.add_to_cart' | t }}</span>
                    <span class="loading-spinner" aria-hidden="true"></span>
                  </button>
                  <p class="form__message form__message--error card__error" data-product-form-error role="alert" hidden></p>
                {%- endform -%}
              </product-form>
            {%- else -%}
              <a
                href="{{ product.url }}"
                class="card__action card__action--primary"
                aria-label="{{ 'products.product.choose_options_named' | t: title: product.title | escape }}"
                {% if settings.card_show_quick_view %}
                  data-quick-view="{{ product.url }}" aria-haspopup="dialog"
                {% endif %}
              >
                {% render 'icon', icon: 'plus' %}
                <span class="card__action-label">{{ 'products.product.choose_options' | t }}</span>
              </a>
            {%- endif -%}
          {%- endif -%}
          {%- if settings.card_show_quick_view -%}
            <button
              type="button"
              class="card__action card__action--icon{% unless show_add %} card__action--solo{% endunless %}"
              data-quick-view="{{ product.url }}"
              aria-label="{{ 'products.product.quick_view_named' | t: title: product.title | escape }}"
              aria-haspopup="dialog"
            >
              {% render 'icon', icon: 'search' %}
            </button>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>

    <div class="card__info">
      {%- if settings.card_show_vendor and product.vendor != blank -%}
        <span class="card__vendor">
          <span class="visually-hidden">{{ 'accessibility.vendor' | t }}</span>
          {{- product.vendor | escape -}}
        </span>
      {%- endif -%}
      <h3 class="card__title">
        <a href="{{ product.url }}" class="card__link" id="CardLink-{{ section_id }}-{{ product.id }}">
          {{- product.title | escape -}}
        </a>
      </h3>

      {%- if settings.card_show_notes -%}
        {%- assign card_notes = product.metafields.custom.notes.value | default: product.metafields.custom.notes -%}
        {%- if card_notes != blank -%}
          <p class="card__notes">{{ card_notes | split: ',' | join: ' · ' | escape }}</p>
        {%- endif -%}
      {%- endif -%}

      {%- if settings.card_show_rating and product.metafields.reviews.rating.value != blank -%}
        {%- liquid
          assign rating = product.metafields.reviews.rating.value
          assign rating_percent = rating.rating | divided_by: rating.scale_max | times: 100
        -%}
        <p class="card__rating">
          <span class="stars" style="--rating: {{ rating_percent }}%;" aria-hidden="true"></span>
          <span class="visually-hidden">{{ 'accessibility.star_reviews_info' | t: rating_value: rating.rating, rating_max: rating.scale_max }}</span>
          <span class="card__rating-count" aria-hidden="true">({{ product.metafields.reviews.rating_count | default: 0 }})</span>
        </p>
      {%- endif -%}

      {% render 'price', product: product %}

      {%- if settings.card_show_swatches -%}
        {%- for option in product.options_with_values -%}
          {%- if option.values.first.swatch -%}
            <ul class="card__swatches" aria-label="{{ option.name | escape }}">
              {%- for value in option.values limit: 5 -%}
                <li>
                  <span
                    class="swatch"
                    title="{{ value | escape }}"
                    style="--swatch-background: {% if value.swatch.image %}url({{ value.swatch.image | image_url: width: 40 }}){% elsif value.swatch.color %}{{ value.swatch.color }}{% endif %};"
                  >
                    <span class="visually-hidden">{{ value | escape }}</span>
                  </span>
                </li>
              {%- endfor -%}
              {%- if option.values.size > 5 -%}
                <li class="card__swatches-more">+{{ option.values.size | minus: 5 }}</li>
              {%- endif -%}
            </ul>
            {%- break -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
    </div>
  {%- else -%}
    {%- assign index = placeholder_index | default: 1 | modulo: 6 | plus: 1 -%}
    <div class="card__media media {{ ratio_class | default: 'media--portrait' }}">
      {{ 'product-' | append: index | placeholder_svg_tag: 'placeholder-svg' }}
    </div>
    <div class="card__info">
      <h3 class="card__title">{{ 'onboarding.product_title' | t }}</h3>
      {% render 'price', product: blank %}
    </div>
  {%- endif -%}
</div>
