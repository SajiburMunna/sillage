{%- comment -%}
  Faceted filtering + sorting form (collections and search).
  Accepts:
  - results {Object} collection or search
  - section_id {String}
  - enable_sorting {Boolean}
{%- endcomment -%}
{%- liquid
  assign sort_by = results.sort_by | default: results.default_sort_by
  assign total_active = 0
  for filter in results.filters
    assign total_active = total_active | plus: filter.active_values.size
    if filter.type == 'price_range' and filter.min_value.value != null or filter.type == 'price_range' and filter.max_value.value != null
      assign total_active = total_active | plus: 1
    endif
  endfor
-%}
<facet-form class="facets" data-section-id="{{ section_id }}">
  <div class="facets__bar">
    <button type="button" class="button button--secondary button--small" data-open-drawer aria-controls="FacetDrawer" aria-expanded="false">
      {% render 'icon', icon: 'filter' %}
      {{ 'sections.collection.filter_and_sort' | t }}
      {%- if total_active > 0 %} ({{ total_active }}){% endif -%}
    </button>
    <p class="facets__count text-muted" id="ProductCount" role="status">
      {%- if results.results_count -%}
        {{ 'templates.search.results_with_count' | t: terms: results.terms, count: results.results_count }}
      {%- else -%}
        {{ 'products.facets.product_count_simple' | t: count: results.products_count }}
      {%- endif -%}
    </p>
  </div>

  <div id="FacetsActive" class="facets__active">
    {%- for filter in results.filters -%}
      {%- for value in filter.active_values -%}
        <a href="{{ value.url_to_remove }}" class="facets__pill" data-facet-remove>
          {{ value.label | escape }} {% render 'icon', icon: 'close' %}
          <span class="visually-hidden">{{ 'sections.collection.remove_filter' | t }}</span>
        </a>
      {%- endfor -%}
      {%- if filter.type == 'price_range' -%}
        {%- if filter.min_value.value != null or filter.max_value.value != null -%}
          <a href="{{ filter.url_to_remove }}" class="facets__pill" data-facet-remove>
            {{ filter.min_value.value | default: 0 | money }}–{{ filter.max_value.value | default: filter.range_max | money }}
            {% render 'icon', icon: 'close' %}
            <span class="visually-hidden">{{ 'sections.collection.remove_filter' | t }}</span>
          </a>
        {%- endif -%}
      {%- endif -%}
    {%- endfor -%}
    {%- if total_active > 0 -%}
      {%- capture clear_url -%}{{ results.url | default: routes.search_url }}{% if results.terms %}?q={{ results.terms | url_encode }}{% endif %}{%- endcapture -%}
      <a href="{{ clear_url }}" class="link" data-facet-remove>{{ 'sections.collection.clear_all' | t }}</a>
    {%- endif -%}
  </div>

  <drawer-component id="FacetDrawer" class="drawer drawer--left" role="dialog" aria-modal="true" aria-labelledby="FacetDrawer-Title">
    <button type="button" class="drawer__overlay" data-drawer-close tabindex="-1" aria-label="{{ 'accessibility.close' | t }}"></button>
    <div class="drawer__panel" tabindex="-1">
      <div class="drawer__header">
        <h2 class="drawer__title" id="FacetDrawer-Title">{{ 'sections.collection.filter_and_sort' | t }}</h2>
        <button type="button" class="icon-button" data-drawer-close data-drawer-focus aria-label="{{ 'accessibility.close' | t }}">
          {% render 'icon', icon: 'close' %}
        </button>
      </div>
      <form class="drawer__body" id="FacetFiltersForm" action="{{ results.url | default: routes.search_url }}">
        <div id="FacetFiltersBody">
          {%- if results.terms -%}
            <input type="hidden" name="q" value="{{ results.terms | escape }}">
            <input type="hidden" name="options[prefix]" value="last">
          {%- endif -%}

          {%- if enable_sorting -%}
            <div class="field">
              <label for="SortBy-{{ section_id }}" class="field__label">{{ 'products.facets.sort_by_label' | t }}</label>
              <select name="sort_by" id="SortBy-{{ section_id }}">
                {%- for option in results.sort_options -%}
                  <option value="{{ option.value | escape }}"{% if option.value == sort_by %} selected{% endif %}>{{ option.name | escape }}</option>
                {%- endfor -%}
              </select>
            </div>
          {%- endif -%}

          {%- for filter in results.filters -%}
            <details class="accordion" {% if filter.active_values.size > 0 or forloop.index <= 2 %}open{% endif %}>
              <summary>
                {{ filter.label | escape }}
                {% render 'icon', icon: 'caret' %}
              </summary>
              <div class="accordion__content">
                {%- case filter.type -%}
                  {%- when 'boolean', 'list' -%}
                    <fieldset class="facets__fieldset">
                      <legend class="visually-hidden">{{ filter.label | escape }}</legend>
                      {%- for value in filter.values -%}
                        {%- capture input_id -%}Filter-{{ filter.param_name | escape }}-{{ forloop.index }}{%- endcapture -%}
                        <label for="{{ input_id }}" class="facets__option{% if value.count == 0 and value.active == false %} is-disabled{% endif %}">
                          <input
                            type="checkbox"
                            name="{{ value.param_name }}"
                            value="{{ value.value }}"
                            id="{{ input_id }}"
                            {% if value.active %}
                              checked
                            {% endif %}
                            {% if value.count == 0 and value.active == false %}
                              disabled
                            {% endif %}
                          >
                          {%- if value.swatch -%}
                            <span class="swatch" style="--swatch-background: {% if value.swatch.image %}url({{ value.swatch.image | image_url: width: 40 }}){% else %}{{ value.swatch.color }}{% endif %};" aria-hidden="true"></span>
                          {%- endif -%}
                          <span>{{ value.label | escape }}</span>
                          <span class="text-muted">({{ value.count }})</span>
                        </label>
                      {%- endfor -%}
                    </fieldset>
                  {%- when 'price_range' -%}
                    <div class="facets__price">
                      <div class="field">
                        <label class="field__label" for="Filter-{{ filter.label | handle }}-GTE">{{ 'products.facets.from' | t }} ({{ cart.currency.symbol }})</label>
                        <input
                          type="number"
                          id="Filter-{{ filter.label | handle }}-GTE"
                          name="{{ filter.min_value.param_name }}"
                          {% if filter.min_value.value %}
                            value="{{ filter.min_value.value | money_without_currency | replace: ',', '' }}"
                          {% endif %}
                          placeholder="0"
                          min="0"
                          max="{{ filter.range_max | money_without_currency | replace: ',', '' }}"
                          inputmode="decimal"
                        >
                      </div>
                      <div class="field">
                        <label class="field__label" for="Filter-{{ filter.label | handle }}-LTE">{{ 'products.facets.to' | t }} ({{ cart.currency.symbol }})</label>
                        <input
                          type="number"
                          id="Filter-{{ filter.label | handle }}-LTE"
                          name="{{ filter.max_value.param_name }}"
                          {% if filter.max_value.value %}
                            value="{{ filter.max_value.value | money_without_currency | replace: ',', '' }}"
                          {% endif %}
                          placeholder="{{ filter.range_max | money_without_currency | replace: ',', '' }}"
                          min="0"
                          max="{{ filter.range_max | money_without_currency | replace: ',', '' }}"
                          inputmode="decimal"
                        >
                      </div>
                    </div>
                {%- endcase -%}
              </div>
            </details>
          {%- endfor -%}
        </div>
        <noscript>
          <button type="submit" class="button button--full">{{ 'products.facets.apply' | t }}</button>
        </noscript>
      </form>
      <div class="drawer__footer">
        <button type="button" class="button button--full" data-drawer-close>{{ 'products.facets.view_results' | t }}</button>
      </div>
    </div>
  </drawer-component>
</facet-form>
