{%- comment -%}
  Article card for blogs, search and featured posts.
  Accepts:
  - article {Object}
  - show_image {Boolean}
  - show_date {Boolean}
  - show_author {Boolean}
  - featured {Boolean} large horizontal layout for the lead story
  - index {Number} picks a placeholder tint when the article has no image
{%- endcomment -%}
{%- liquid
  assign word_count = article.content | strip_html | split: ' ' | size
  assign minutes = word_count | divided_by: 220 | at_least: 1
  assign tints = '#c97b63,#8a5235,#d9a441,#6f8f7a,#b98bb5,#3b4f6b' | split: ','
  assign tint_index = index | default: 1 | modulo: 6
-%}
<article class="article-card{% if featured %} article-card--featured{% endif %}" data-reveal>
  {%- if show_image -%}
    <div class="article-card__media">
      {%- if article.image -%}
        {{
          article.image
          | image_url: width: 1600
          | image_tag:
            widths: '375, 550, 750, 1100, 1600',
            sizes: '(min-width: 990px) 50vw, 100vw',
            loading: 'lazy',
            alt: article.image.alt | default: article.title
        }}
      {%- else -%}
        {% render 'placeholder-bottle', tint: tints[tint_index], variant: index %}
      {%- endif -%}
    </div>
  {%- endif -%}
  <div class="article-card__body">
    <p class="article-card__meta">
      {%- if show_date -%}{{ article.published_at | time_tag: format: 'date' }}<span aria-hidden="true"> · </span>{%- endif -%}
      <span>{{ 'blogs.article.reading_time' | t: count: minutes }}</span>
      {%- if show_author -%}<span aria-hidden="true"> · </span>{{ article.author }}{%- endif -%}
    </p>
    <h3 class="article-card__title">
      <a href="{{ article.url }}" class="article-card__link">{{ article.title | escape }}</a>
    </h3>
    {%- if article.excerpt.size > 0 or article.content.size > 0 -%}
      <p class="article-card__excerpt">
        {%- if featured -%}
          {{ article.excerpt_or_content | strip_html | truncatewords: 40 }}
        {%- else -%}
          {{ article.excerpt_or_content | strip_html | truncatewords: 22 }}
        {%- endif -%}
      </p>
    {%- endif -%}
    <span class="article-card__more" aria-hidden="true">{{ 'blogs.article.read_more' | t }} {% render 'icon', icon: 'arrow' %}</span>
  </div>
</article>
