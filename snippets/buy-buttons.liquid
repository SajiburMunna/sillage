{%- comment -%}
  Product form: quantity, add to cart, dynamic checkout, gift card recipient, pickup availability.
  Accepts:
  - product {Object}
  - block {Object}
  - section_id {String}
  - show_quantity {Boolean}
  - dynamic_checkout {Boolean} show express checkout when there is no block (quick view)
{%- endcomment -%}
{%- assign current_variant = product.selected_or_first_available_variant -%}
<div class="buy-buttons" {{ block.shopify_attributes }}>
  <product-form>
    {%- assign product_form_id = 'ProductForm-' | append: section_id -%}
    {%- form 'product', product, id: product_form_id, novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
      <input type="hidden" name="id" value="{{ current_variant.id }}">

      {%- if product.gift_card? and block.settings.show_gift_card_recipient -%}
        <details class="accordion gift-card-recipient">
          <summary>{{ 'recipient.form.checkbox' | t }} {% render 'icon', icon: 'caret' %}</summary>
          <div class="accordion__content">
            <input type="hidden" name="properties[__shopify_send_gift_card_to_recipient]" value="on">
            <div class="field">
              <label class="field__label" for="Recipient-email-{{ section_id }}">{{ 'recipient.form.email_label' | t }}</label>
              <input id="Recipient-email-{{ section_id }}" type="email" name="properties[Recipient email]" autocomplete="email">
            </div>
            <div class="field">
              <label class="field__label" for="Recipient-name-{{ section_id }}">{{ 'recipient.form.name_label' | t }}</label>
              <input id="Recipient-name-{{ section_id }}" type="text" name="properties[Recipient name]" autocomplete="name">
            </div>
            <div class="field">
              <label class="field__label" for="Recipient-message-{{ section_id }}">{{ 'recipient.form.message_label' | t }}</label>
              <textarea id="Recipient-message-{{ section_id }}" name="properties[Message]" maxlength="200" rows="3"></textarea>
            </div>
            <div class="field">
              <label class="field__label" for="Recipient-date-{{ section_id }}">{{ 'recipient.form.send_on_label' | t }}</label>
              <input id="Recipient-date-{{ section_id }}" type="date" name="properties[Send on]" pattern="\d{4}-\d{2}-\d{2}">
            </div>
          </div>
        </details>
      {%- endif -%}

      {%- comment -%} Selling plans (subscriptions) {%- endcomment -%}
      {%- if product.selling_plan_groups.size > 0 -%}
        <fieldset class="selling-plans" data-product-update="selling-plans">
          <legend class="variant-picker__legend">{{ 'products.product.purchase_options' | t }}</legend>
          {%- unless product.requires_selling_plan -%}
            <label class="selling-plans__option">
              <input type="radio" name="selling_plan" value="" {% unless current_variant.selected_selling_plan_allocation %}checked{% endunless %}>
              <span class="selling-plans__body">
                <span class="selling-plans__name">{{ 'products.product.one_time_purchase' | t }}</span>
              </span>
              <span class="selling-plans__price">{{ current_variant.price | money }}</span>
            </label>
          {%- endunless -%}
          {%- for group in product.selling_plan_groups -%}
            {%- for plan in group.selling_plans -%}
              {%- liquid
                assign plan_price = nil
                for allocation in current_variant.selling_plan_allocations
                  if allocation.selling_plan.id == plan.id
                    assign plan_price = allocation.price
                  endif
                endfor
              -%}
              <label class="selling-plans__option">
                <input
                  type="radio"
                  name="selling_plan"
                  value="{{ plan.id }}"
                  {% if product.requires_selling_plan and forloop.parentloop.first and forloop.first %}
                    checked
                  {% elsif plan.selected %}
                    checked
                  {% endif %}
                >
                <span class="selling-plans__body">
                  <span class="selling-plans__name">{{ plan.name | escape }}</span>
                  {%- if group.name != plan.name -%}
                    <span class="selling-plans__group">{{ group.name | escape }}</span>
                  {%- endif -%}
                </span>
                {%- if plan_price != nil -%}
                  <span class="selling-plans__price">{{ plan_price | money }}</span>
                {%- endif -%}
              </label>
            {%- endfor -%}
          {%- endfor -%}
        </fieldset>
      {%- endif -%}

      <div class="buy-buttons__row">
        {%- if show_quantity -%}
          <quantity-input class="quantity">
            <button class="quantity__button" name="minus" type="button" aria-label="{{ 'products.product.quantity.decrease' | t: product: product.title | escape }}">
              {% render 'icon', icon: 'minus' %}
            </button>
            <label class="visually-hidden" for="Quantity-{{ section_id }}">{{ 'products.product.quantity.label' | t }}</label>
            <input
              class="quantity__input"
              type="number"
              name="quantity"
              id="Quantity-{{ section_id }}"
              min="{{ current_variant.quantity_rule.min }}"
              {% if current_variant.quantity_rule.max != null %}
                max="{{ current_variant.quantity_rule.max }}"
              {% endif %}
              step="{{ current_variant.quantity_rule.increment }}"
              value="{{ current_variant.quantity_rule.min }}"
            >
            <button class="quantity__button" name="plus" type="button" aria-label="{{ 'products.product.quantity.increase' | t: product: product.title | escape }}">
              {% render 'icon', icon: 'plus' %}
            </button>
          </quantity-input>
        {%- endif -%}

        <div data-product-update="add-button" style="flex: 1;">
          <button
            type="submit"
            name="add"
            class="button button--full"
            {% if current_variant.available == false or current_variant == null %}
              aria-disabled="true" data-sold-out
            {% endif %}
          >
            <span class="button__label">
              {%- if current_variant == null -%}
                {{ 'products.product.unavailable' | t }}
              {%- elsif current_variant.available -%}
                {{ 'products.product.add_to_cart' | t }}
              {%- else -%}
                {{ 'products.product.sold_out' | t }}
              {%- endif -%}
            </span>
            <span class="loading-spinner" aria-hidden="true"></span>
          </button>
        </div>
      </div>

      {%- comment -%} B2B: quantity rules and volume pricing (refreshed on variant change) {%- endcomment -%}
      <div class="volume-pricing" data-product-update="volume-pricing">
        {%- if current_variant != null -%}
          {%- assign rule = current_variant.quantity_rule -%}
          {%- if rule.min > 1 or rule.increment > 1 or rule.max != null -%}
            <p class="volume-pricing__rule">
              {%- if rule.increment > 1 -%}
                <span>{{ 'products.product.volume_pricing.increments_of' | t: quantity: rule.increment }}</span>
              {%- endif -%}
              {%- if rule.min > 1 -%}
                <span>{{ 'products.product.volume_pricing.minimum_of' | t: quantity: rule.min }}</span>
              {%- endif -%}
              {%- if rule.max != null -%}
                <span>{{ 'products.product.volume_pricing.maximum_of' | t: quantity: rule.max }}</span>
              {%- endif -%}
            </p>
          {%- endif -%}

          {%- if current_variant.quantity_price_breaks.size > 0 -%}
            <details class="volume-pricing__details">
              <summary>
                <span>{{ 'products.product.volume_pricing.title' | t }}</span>
                {% render 'icon', icon: 'caret' %}
              </summary>
              <table class="volume-pricing__table">
                <caption class="visually-hidden">{{ 'products.product.volume_pricing.title' | t }}</caption>
                <thead>
                  <tr>
                    <th scope="col">{{ 'products.product.quantity.label' | t }}</th>
                    <th scope="col">{{ 'products.product.volume_pricing.price_each' | t }}</th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td>{{ rule.min }}+</td>
                    <td>{{ current_variant.price | money }}</td>
                  </tr>
                  {%- for price_break in current_variant.quantity_price_breaks -%}
                    <tr>
                      <td>{{ price_break.minimum_quantity }}+</td>
                      <td>{{ price_break.price | money }}</td>
                    </tr>
                  {%- endfor -%}
                </tbody>
              </table>
            </details>
          {%- endif -%}
        {%- endif -%}
      </div>

      {%- if block.settings.show_dynamic_checkout or dynamic_checkout -%}
        <div class="buy-buttons__dynamic">
          {{ form | payment_button }}
        </div>
      {%- endif -%}

      <p class="form__message form__message--error" data-product-form-error role="alert" hidden></p>
    {%- endform -%}
  </product-form>

  <div class="buy-buttons__notify" data-product-update="notify">
    {%- if current_variant != null and current_variant.available == false -%}
      {%- assign notify_id = 'Notify-' | append: section_id -%}
      {%- form 'contact', id: notify_id, class: 'notify-form' -%}
        {%- if form.posted_successfully? -%}
          <p class="form__message form__message--success" role="status">{% render 'icon', icon: 'check' %} {{ 'products.product.notify.success' | t }}</p>
        {%- else -%}
          <p class="notify-form__heading">{% render 'icon', icon: 'clock' %} {{ 'products.product.notify.heading' | t }}</p>
          <input type="hidden" name="contact[{{ 'products.product.notify.body_label' | t | escape }}]" value="{{ product.title | escape }}{% unless product.has_only_default_variant %} – {{ current_variant.title | escape }}{% endunless %} ({{ request.origin }}{{ current_variant.url }})">
          <div class="notify-form__row">
            <div class="field">
              <label class="visually-hidden" for="{{ notify_id }}-Email">{{ 'products.product.notify.label' | t }}</label>
              <input
                id="{{ notify_id }}-Email"
                type="email"
                name="contact[email]"
                autocomplete="email"
                placeholder="{{ 'products.product.notify.label' | t }}"
                required
                {% if form.errors %}
                  aria-invalid="true" aria-describedby="{{ notify_id }}-Error"
                {% endif %}
              >
            </div>
            <button type="submit" class="button button--secondary">{{ 'products.product.notify.button' | t }}</button>
          </div>
          {%- if form.errors -%}
            <p class="form__message form__message--error" id="{{ notify_id }}-Error">{% render 'icon', icon: 'error' %} {{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
          {%- endif -%}
        {%- endif -%}
      {%- endform -%}
    {%- endif -%}
  </div>

  {%- if block.settings.show_pickup_availability -%}
    <pickup-availability
      class="pickup-availability"
      data-root-url="{{ routes.root_url | append: '/' | replace: '//', '/' }}"
      data-variant-id="{{ current_variant.id }}"
      {% if current_variant.available == false %}
        hidden
      {% endif %}
    ></pickup-availability>
  {%- endif -%}
</div>
