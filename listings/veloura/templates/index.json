    "ritual": {
      "type": "ritual-steps",
      "settings": {
        "eyebrow": "Candle care",
        "heading": "The <em>first</em> burn",
        "color_scheme": "scheme-2"
      },
      "blocks": {
        "step_1": {
          "type": "step",
          "settings": {
            "title": "Trim the wick",
            "text": "<p>Cut the wick to 5 mm before every burn for a calm, even flame.</p>"
          }
        },
        "step_2": {
          "type": "step",
          "settings": {
            "title": "Let it pool",
            "text": "<p>On the first light, burn until the melt pool reaches the edge. About two hours.</p>"
          }
        },
        "step_3": {
          "type": "step",
          "settings": {
            "title": "Snuff, never blow",
            "text": "<p>Dip the wick into the wax or use a snuffer to keep the room free of smoke.</p>"
          }
        }
      },
