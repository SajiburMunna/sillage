          "settings": {
            "title": "Warm the skin",
            "text": "<p>Scent holds best on warm, moisturised skin. Apply after a shower.</p>"
          }
        },
        "step_2": {
          "type": "step",
          "settings": {
            "title": "Find the pulse points",
            "text": "<p>Spray once on each wrist and once at the base of the neck, from 15 cm away.</p>"
          }
        },
        "step_3": {
          "type": "step",
          "settings": {
            "title": "Let it settle",
            "text": "<p>Don’t rub. Give the heart notes ten minutes to open before you judge it.</p>"
