<footer class="footer color-{{ section.settings.color_scheme }}">
  <div class="page-width">
    <div class="footer__top">

      <div class="footer__blocks">
        {%- for block in section.blocks -%}
          <div class="footer__block" {{ block.shopify_attributes }}>
            {%- case block.type -%}
              {%- when 'link_list' -%}
                {%- if block.settings.heading != blank -%}
                  <h2 class="footer__heading">{{ block.settings.heading | escape }}</h2>
                {%- endif -%}
                <ul class="footer__list" role="list">
                  {%- for link in block.settings.menu.links -%}
                    <li>
                      <a href="{{ link.url }}" class="link-underline"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>
                    </li>
                  {%- endfor -%}
                </ul>
              {%- when 'text' -%}
                {%- if block.settings.heading != blank -%}
                  <h2 class="footer__heading">{{ block.settings.heading | escape }}</h2>
                {%- endif -%}
                <div class="rte">{{ block.settings.text }}</div>
              {%- when 'newsletter' -%}
                {%- if block.settings.heading != blank -%}
                  <h2 class="footer__heading">{{ block.settings.heading | escape }}</h2>
                {%- endif -%}
                {% render 'newsletter-form', form_id: 'FooterNewsletter' %}
              {%- when '@app' -%}
                {% render block %}
            {%- endcase -%}
          </div>
        {%- endfor -%}
      </div>
    </div>

    {%- if section.settings.show_wordmark -%}
      <a href="{{ routes.root_url }}" class="footer__wordmark" style="--chars: {{ shop.name | strip | size | at_least: 4 }};" data-reveal>{{ shop.name | strip }}</a>
    {%- endif -%}

    <div class="footer__bottom">
      <div class="footer__legal">
        <span>
          &copy; {{ 'now' | date: '%Y' }}, {{ shop.name | link_to: routes.root_url }}
          {%- if section.settings.legal_text != blank %} · {{ section.settings.legal_text | escape }}{% endif -%}
        </span>
        {%- if section.settings.show_policy -%}
          <ul class="footer__list footer__policies" role="list">
            {%- for policy in shop.policies -%}
              {%- if policy != blank -%}
                <li><a href="{{ policy.url }}" class="link-underline">{{ policy.title | escape }}</a></li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>

      {% render 'localization-form', show_country: section.settings.show_country, show_language: section.settings.show_language, id_prefix: 'Footer' %}

      {%- if section.settings.show_social or section.settings.enable_follow_on_shop -%}
        <div class="footer__social">
          {%- if section.settings.show_social -%}
            {% render 'social-icons' %}
          {%- endif -%}
          {%- if section.settings.enable_follow_on_shop and request.page_type != 'password' -%}
            <div class="footer__follow">{{ shop | login_button: action: 'follow' }}</div>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if section.settings.payment_enable -%}
        <div>
          <span class="visually-hidden">{{ 'sections.footer.payment' | t }}</span>
          <ul class="payment-icons" role="list">
            {%- for type in shop.enabled_payment_types -%}
              <li>{{ type | payment_type_svg_tag: class: 'icon' }}</li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "t:sections.footer.name",
  "enabled_on": { "groups": ["footer"] },
  "blocks": [
    { "type": "@app" },
    {
      "type": "link_list",
      "name": "t:sections.footer.blocks.link_list.name",
      "settings": [
        { "type": "inline_richtext", "id": "heading", "default": "Quick links", "label": "t:sections.footer.blocks.link_list.settings.heading.label" },
        { "type": "link_list", "id": "menu", "default": "footer", "label": "t:sections.footer.blocks.link_list.settings.menu.label" }
      ]
    },
    {
      "type": "text",
      "name": "t:sections.footer.blocks.text.name",
      "settings": [
        { "type": "inline_richtext", "id": "heading", "default": "About the house", "label": "t:sections.footer.blocks.text.settings.heading.label" },
        { "type": "richtext", "id": "text", "default": "<p>Share your fragrance philosophy, where your scents are made, or how customers can reach you.</p>", "label": "t:sections.footer.blocks.text.settings.text.label" }
      ]
    },
    {
      "type": "newsletter",
      "name": "t:sections.footer.blocks.newsletter.name",
      "limit": 1,
      "settings": [
        { "type": "inline_richtext", "id": "heading", "default": "Join the list", "label": "t:sections.footer.blocks.newsletter.settings.heading.label" }
      ]
    }
  ],
  "settings": [
    { "type": "checkbox", "id": "show_wordmark", "default": true, "label": "t:sections.footer.settings.show_wordmark.label" },
    { "type": "text", "id": "legal_text", "label": "t:sections.footer.settings.legal_text.label", "default": "For external use only." },
    { "type": "checkbox", "id": "show_policy", "default": true, "label": "t:sections.footer.settings.show_policy.label" },
    { "type": "checkbox", "id": "enable_follow_on_shop", "default": true, "label": "t:sections.footer.settings.enable_follow_on_shop.label", "info": "t:sections.footer.settings.enable_follow_on_shop.info" },
    { "type": "checkbox", "id": "show_social", "default": true, "label": "t:sections.footer.settings.show_social.label", "info": "t:sections.footer.settings.show_social.info" },
    { "type": "checkbox", "id": "payment_enable", "default": true, "label": "t:sections.footer.settings.payment_enable.label" },
    { "type": "header", "content": "t:sections.footer.settings.header_localization.content" },
    { "type": "checkbox", "id": "show_country", "default": true, "label": "t:sections.all.show_country.label" },
    { "type": "checkbox", "id": "show_language", "default": true, "label": "t:sections.all.show_language.label" },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.color_scheme.label", "default": "scheme-1" }
  ]
}
{% endschema %}
