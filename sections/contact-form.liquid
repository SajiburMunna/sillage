<section
  class="section-padding color-{{ section.settings.color_scheme }}"
  style="--pad-top: {{ section.settings.padding_top }}px; --pad-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="page-width page-width--narrow">
    {%- if section.settings.heading != blank -%}
      <h2 class="h-display h-display--md">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- form 'contact', id: 'ContactForm' -%}
      {%- if form.posted_successfully? -%}
        <p class="form__message form__message--success" tabindex="-1" autofocus>
          {% render 'icon', icon: 'check' %}
          {{ 'templates.contact.form.post_success' | t }}
        </p>
      {%- elsif form.errors -%}
        <div class="form__message form__message--error" role="alert">
          {% render 'icon', icon: 'error' %}
          {{ form.errors | default_errors }}
        </div>
      {%- endif -%}
      <div class="contact-form__row">
        <div class="field">
          <label class="field__label" for="ContactForm-name">{{ 'templates.contact.form.name' | t }}</label>
          <input id="ContactForm-name" type="text" autocomplete="name" name="contact[{{ 'templates.contact.form.name' | t }}]" value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}">
        </div>
        <div class="field">
          <label class="field__label" for="ContactForm-email">{{ 'templates.contact.form.email' | t }} <span aria-hidden="true">*</span></label>
          <input id="ContactForm-email" type="email" autocomplete="email" name="contact[email]" required aria-required="true" value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}">
        </div>
      </div>
      <div class="field">
        <label class="field__label" for="ContactForm-phone">{{ 'templates.contact.form.phone' | t }}</label>
        <input id="ContactForm-phone" type="tel" autocomplete="tel" name="contact[{{ 'templates.contact.form.phone' | t }}]" pattern="[0-9\-]*" value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}">
      </div>
      <div class="field">
        <label class="field__label" for="ContactForm-body">{{ 'templates.contact.form.comment' | t }}</label>
        <textarea rows="8" id="ContactForm-body" name="contact[{{ 'templates.contact.form.comment' | t }}]">{{- form.body -}}</textarea>
      </div>
      <button type="submit" class="button">{{ 'templates.contact.form.send' | t }}</button>
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.contact_form.name",
  "tag": "div",
  "class": "section",
  "settings": [
    { "type": "inline_richtext", "id": "heading", "default": "Get in touch", "label": "t:sections.all.heading" },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.color_scheme.label", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "t:sections.all.padding_top", "default": 40 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "t:sections.all.padding_bottom", "default": 72 }
  ],
  "presets": [{ "name": "t:sections.contact_form.presets.name" }]
}
{% endschema %}
