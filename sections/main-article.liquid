{{ 'section-pages.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign word_count = article.content | strip_html | split: ' ' | size
  assign minutes = word_count | divided_by: 220 | at_least: 1
-%}

<article
  class="article section-padding color-{{ section.settings.color_scheme }}"
  style="--pad-top: {{ section.settings.padding_top }}px; --pad-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="page-width">
    {%- if section.settings.show_breadcrumbs -%}{% render 'breadcrumbs' %}{%- endif -%}
    <header class="article__hero{% if article.image %} article__hero--image{% endif %}">
      <div class="article__heading">
        <p class="eyebrow">
          {{- article.published_at | time_tag: format: 'date' -}}
          <span aria-hidden="true">&nbsp;·&nbsp;</span>{{ 'blogs.article.reading_time' | t: count: minutes }}
        </p>
        <h1 class="h-display h-display--md article__title">{{ article.title | escape }}</h1>
        {%- if section.settings.show_author -%}
          <p class="article__author">{{ 'blogs.article.by_author' | t: author: article.author }}</p>
        {%- endif -%}
      </div>
      {%- if article.image -%}
        <div class="vessel article__media">
          {{
            article.image
            | image_url: width: 1600
            | image_tag: widths: '500, 750, 1100, 1600', sizes: '(min-width: 990px) 45vw, 100vw', loading: 'eager', fetchpriority: 'high', alt: article.image.alt | default: article.title
          }}
        </div>
      {%- endif -%}
    </header>
  </div>

  <div class="page-width page-width--narrow">
    <div class="rte article__content">{{ article.content }}</div>

    <div class="article__footer">
      {%- if article.tags.size > 0 -%}
        <ul class="article__tags" role="list">
          {%- for tag in article.tags -%}
            <li><a href="{{ blog.url }}/tagged/{{ tag | handleize }}" class="blog-tags__tag">{{ tag | escape }}</a></li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
      <share-button class="article__share" data-url="{{ request.origin }}{{ article.url }}" data-title="{{ article.title | escape }}">
        <button type="button" class="link product__share-button">
          {% render 'icon', icon: 'share' %}
          <span data-share-label>{{ 'blogs.article.share' | t }}</span>
        </button>
        <span class="visually-hidden" role="status" data-share-status data-success="{{ 'general.share.success_message' | t | escape }}"></span>
      </share-button>
    </div>
  </div>

  {%- if section.settings.related_products.count > 0 -%}
    <div class="page-width article__related">
      <h2 class="h3 article__related-title">{{ section.settings.related_heading | escape }}</h2>
      <ul class="grid" role="list" style="--cols: 4; --cols-tablet: 3; --cols-mobile: 2;">
        {%- for product in section.settings.related_products limit: 4 -%}
          <li>{% render 'product-card', product: product, section_id: section.id %}</li>
        {%- endfor -%}
      </ul>
    </div>
  {%- endif -%}

  <div class="page-width page-width--narrow">
    {%- if blog.comments_enabled? -%}
      <section class="article-comments">
        <h2 class="h3">{{ 'blogs.article.comments' | t: count: article.comments_count }}</h2>
        {%- paginate article.comments by 10 -%}
          {%- for comment in article.comments -%}
            <div class="article-comment">
              <div class="rte">{{ comment.content }}</div>
              <p class="text-muted">{{ comment.author }} · {{ comment.created_at | time_tag: format: 'date' }}</p>
            </div>
          {%- endfor -%}
          {% render 'pagination', paginate: paginate %}
        {%- endpaginate -%}

        {%- form 'new_comment', article -%}
          <h2 class="h3 article-comments__form-title">{{ 'blogs.article.comment_form_title' | t }}</h2>
          {%- if form.errors -%}
            <div class="form__message form__message--error" role="alert">{{ form.errors | default_errors }}</div>
          {%- elsif form.posted_successfully? -%}
            <p class="form__message form__message--success">
              {%- if blog.moderated? -%}{{ 'blogs.article.success_moderated' | t }}{%- else -%}{{ 'blogs.article.success' | t }}{%- endif -%}
            </p>
          {%- endif -%}
          <div class="field">
            <label class="field__label" for="CommentForm-author">{{ 'blogs.article.name' | t }} <span aria-hidden="true">*</span></label>
            <input type="text" name="comment[author]" id="CommentForm-author" autocomplete="name" value="{{ form.author | escape }}" required aria-required="true">
          </div>
          <div class="field">
            <label class="field__label" for="CommentForm-email">{{ 'blogs.article.email' | t }} <span aria-hidden="true">*</span></label>
            <input type="email" name="comment[email]" id="CommentForm-email" autocomplete="email" value="{{ form.email | escape }}" required aria-required="true">
          </div>
          <div class="field">
            <label class="field__label" for="CommentForm-body">{{ 'blogs.article.message' | t }} <span aria-hidden="true">*</span></label>
            <textarea rows="5" name="comment[body]" id="CommentForm-body" required aria-required="true">{{ form.body | escape }}</textarea>
          </div>
          {%- if blog.moderated? -%}
            <p class="text-muted">{{ 'blogs.article.moderated' | t }}</p>
          {%- endif -%}
          <button type="submit" class="button">{{ 'blogs.article.post' | t }}</button>
        {%- endform -%}
      </section>
    {%- endif -%}

    <p class="article__back">
      <a href="{{ blog.url }}" class="button button--tertiary article__back-link">{% render 'icon', icon: 'arrow-left' %} {{ 'blogs.article.back_to_blog' | t: title: blog.title }}</a>
    </p>
  </div>
</article>

<script type="application/ld+json">
  {{ article | structured_data }}
</script>

{% schema %}
{
  "name": "t:sections.main_article.name",
  "tag": "div",
  "class": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_breadcrumbs",
      "default": true,
      "label": "t:sections.all.show_breadcrumbs"
    },
    {
      "type": "product_list",
      "id": "related_products",
      "limit": 4,
      "label": "t:sections.main_article.settings.related_products.label",
      "info": "t:sections.main_article.settings.related_products.info"
    },
    {
      "type": "text",
      "id": "related_heading",
      "default": "Scents in this story",
      "label": "t:sections.main_article.settings.related_heading.label"
    },
    {
      "type": "checkbox",
      "id": "show_author",
      "default": true,
      "label": "t:sections.main_blog.settings.show_author.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.color_scheme.label",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding_top",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding_bottom",
      "default": 72
    }
  ]
}
{% endschema %}
