{{ 'section-collection.css' | asset_url | stylesheet_tag }}

<section
  class="section-padding color-{{ section.settings.color_scheme }}"
  style="--pad-top: {{ section.settings.padding_top }}px; --pad-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="page-width">
    <header class="collection-hero">
      <p class="eyebrow">{{ 'sections.collection.label' | t }}</p>
      <h1 class="h-display h-display--md collection-hero__title">{{ collection.title | escape }}</h1>
      {%- if section.settings.show_description and collection.description != blank -%}
        <div class="collection-hero__description rte">{{ collection.description }}</div>
      {%- endif -%}
      {%- if section.settings.show_image and collection.image -%}
        <div class="collection-hero__media media media--wide">
          {{
            collection.image
            | image_url: width: 2000
            | image_tag: widths: '750, 1100, 1500, 2000', sizes: '100vw', loading: 'eager', fetchpriority: 'high', alt: collection.image.alt | default: collection.title
          }}
        </div>
      {%- endif -%}
    </header>

    {%- paginate collection.products by section.settings.products_per_page -%}
      {%- if section.settings.enable_filtering or section.settings.enable_sorting -%}
        {% render 'facets', results: collection, section_id: section.id, enable_sorting: section.settings.enable_sorting %}
      {%- endif -%}

      <div id="ProductGridContainer" class="product-grid-container">
        {%- if collection.products.size == 0 -%}
          <div class="collection-empty">
            <p class="h3">{{ 'sections.collection.empty' | t }}</p>
            <a href="{{ collection.url }}" class="link" data-facet-remove>{{ 'sections.collection.use_fewer_filters_html' | t: link: collection.url }}</a>
          </div>
        {%- else -%}
          <ul class="grid" role="list" style="--cols: {{ section.settings.columns_desktop }}; --cols-tablet: 3; --cols-mobile: {{ section.settings.columns_mobile }};">
            {%- for product in collection.products -%}
              {%- liquid
                assign lazy = true
                if forloop.index <= section.settings.columns_desktop
                  assign lazy = false
                endif
              -%}
              <li>{% render 'product-card', product: product, lazy: lazy, section_id: section.id %}</li>
            {%- endfor -%}
          </ul>
          {% render 'pagination', paginate: paginate %}
        {%- endif -%}
      </div>
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.main_collection.name",
  "tag": "div",
  "class": "section",
  "settings": [
    { "type": "range", "id": "products_per_page", "min": 8, "max": 36, "step": 4, "default": 16, "label": "t:sections.main_collection.settings.products_per_page.label" },
    { "type": "range", "id": "columns_desktop", "min": 2, "max": 5, "step": 1, "default": 4, "label": "t:sections.all.columns_desktop" },
    {
      "type": "select",
      "id": "columns_mobile",
      "default": "2",
      "label": "t:sections.all.columns_mobile",
      "options": [
        { "value": "1", "label": "t:sections.all.columns_mobile_options.one" },
        { "value": "2", "label": "t:sections.all.columns_mobile_options.two" }
      ]
    },
    { "type": "checkbox", "id": "show_description", "default": true, "label": "t:sections.main_collection.settings.show_description.label" },
    { "type": "checkbox", "id": "show_image", "default": false, "label": "t:sections.main_collection.settings.show_image.label" },
    { "type": "checkbox", "id": "enable_filtering", "default": true, "label": "t:sections.main_collection.settings.enable_filtering.label", "info": "t:sections.main_collection.settings.enable_filtering.info" },
    { "type": "checkbox", "id": "enable_sorting", "default": true, "label": "t:sections.main_collection.settings.enable_sorting.label" },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.color_scheme.label", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "t:sections.all.padding_top", "default": 48 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "t:sections.all.padding_bottom", "default": 72 }
  ]
}
{% endschema %}
