{{ 'section-home.css' | asset_url | stylesheet_tag }}

<section
  class="closing section-padding color-{{ section.settings.color_scheme }}"
  style="--pad-top: {{ section.settings.padding_top }}px; --pad-bottom: {{ section.settings.padding_bottom }}px;"
  data-header-tone="{% assign bg_brightness = section.settings.color_scheme.settings.background | color_brightness %}{% if bg_brightness < 128 %}dark{% else %}light{% endif %}"
>
  {%- if section.settings.show_trail -%}{% render 'trail' %}{%- endif -%}
  <div class="page-width closing__grid">
    <div class="closing__content" data-reveal>
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="h-display h-display--lg closing__title">{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.text != blank -%}<div class="rte closing__text">{{ section.settings.text }}</div>{%- endif -%}

      {%- if section.settings.show_newsletter -%}
        <div class="closing__form">
          {%- assign closing_form_id = 'ClosingNewsletter-' | append: section.id -%}
          {% render 'newsletter-form', form_id: closing_form_id %}
        </div>
      {%- elsif section.settings.button_label != blank -%}
        <a
          {% if section.settings.button_link != blank %}
            href="{{ section.settings.button_link }}"
          {% else %}
            role="link" aria-disabled="true"
          {% endif %}
          class="button"
        >
          {{- section.settings.button_label | escape -}}
        </a>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <ul class="closing__perks" role="list">
          {%- for block in section.blocks -%}
            <li {{ block.shopify_attributes }}>
              {% render 'icon', icon: block.settings.icon %}
              <span>{{ block.settings.text | escape }}</span>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>

    <div class="closing__visual" data-reveal>
      <div class="vessel closing__vessel">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 1200 | image_tag: widths: '500, 800, 1200', sizes: '(min-width: 990px) 35vw, 80vw', loading: 'lazy', alt: section.settings.image.alt }}
        {%- else -%}
          {% render 'placeholder-bottle', tint: 'rgb(var(--color-accent))', variant: 3 %}
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.closing_banner.name",
  "tag": "div",
  "class": "section",
  "max_blocks": 4,
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.all.image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "default": "Join the house",
      "label": "t:sections.all.eyebrow"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:sections.all.heading",
      "info": "t:sections.closing_banner.settings.heading.info",
      "default": "Leave a <em>trail</em>"
    },
    {
      "type": "richtext",
      "id": "text",
      "default": "<p>New scents, restocks and private events, a few times a season. Never more.</p>",
      "label": "t:sections.all.text"
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "default": true,
      "label": "t:sections.closing_banner.settings.show_newsletter.label"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:sections.all.button_label",
      "info": "t:sections.closing_banner.settings.button_label.info"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:sections.all.button_link"
    },
    {
      "type": "checkbox",
      "id": "show_trail",
      "default": true,
      "label": "t:sections.closing_banner.settings.show_trail.label",
      "info": "t:sections.closing_banner.settings.show_trail.info"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.color_scheme.label",
      "default": "scheme-3"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 8,
      "unit": "px",
      "label": "t:sections.all.padding_top",
      "default": 128
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 8,
      "unit": "px",
      "label": "t:sections.all.padding_bottom",
      "default": 128
    }
  ],
  "blocks": [
    {
      "type": "perk",
      "name": "t:sections.closing_banner.blocks.perk.name",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "default": "gift",
          "label": "t:sections.all.icon.label",
          "options": [
            {
              "value": "truck",
              "label": "t:sections.all.icon.options.truck"
            },
            {
              "value": "gift",
              "label": "t:sections.all.icon.options.gift"
            },
            {
              "value": "leaf",
              "label": "t:sections.all.icon.options.leaf"
            },
            {
              "value": "return",
              "label": "t:sections.all.icon.options.return"
            },
            {
              "value": "lock",
              "label": "t:sections.all.icon.options.lock"
            },
            {
              "value": "bottle",
              "label": "t:sections.all.icon.options.bottle"
            },
            {
              "value": "vial",
              "label": "t:sections.all.icon.options.vial"
            },
            {
              "value": "droplet",
              "label": "t:sections.all.icon.options.droplet"
            },
            {
              "value": "heart",
              "label": "t:sections.all.icon.options.heart"
            },
            {
              "value": "clock",
              "label": "t:sections.all.icon.options.clock"
            },
            {
              "value": "chat",
              "label": "t:sections.all.icon.options.chat"
            }
          ]
        },
        {
          "type": "text",
          "id": "text",
          "default": "Early access to new scents",
          "label": "t:sections.all.text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.closing_banner.presets.name",
      "blocks": [
        {
          "type": "perk",
          "settings": {
            "icon": "vial",
            "text": "Early access to new scents"
          }
        },
        {
          "type": "perk",
          "settings": {
            "icon": "gift",
            "text": "A birthday gift every year"
          }
        },
        {
          "type": "perk",
          "settings": {
            "icon": "heart",
            "text": "Private events and refills"
          }
        }
      ]
    }
  ]
}
{% endschema %}
