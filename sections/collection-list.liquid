{{ 'section-collection.css' | asset_url | stylesheet_tag }}

<section
  class="section-padding color-{{ section.settings.color_scheme }}"
  style="--pad-top: {{ section.settings.padding_top }}px; --pad-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="section-header" data-reveal>
        <h2 class="section-header__title h-display h-display--md">{{ section.settings.heading }}</h2>
      </div>
    {%- endif -%}
    <ul class="grid" role="list" style="--cols: {{ section.settings.columns_desktop }}; --cols-tablet: 2; --cols-mobile: 1;">
      {%- for block in section.blocks -%}
        {%- assign collection = block.settings.collection -%}
        <li data-reveal {{ block.shopify_attributes }}>
          <a
            {% if collection != blank %}
              href="{{ collection.url }}"
            {% else %}
              role="link" aria-disabled="true"
            {% endif %}
            class="collection-tile"
          >
            <div class="media media--{{ section.settings.image_ratio }}">
              {%- assign image = block.settings.image | default: collection.featured_image -%}
              {%- if image -%}
                {{ image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '375, 550, 750, 1000, 1200', sizes: '(min-width: 990px) 33vw, (min-width: 750px) 50vw, 100vw', alt: image.alt | default: collection.title }}
              {%- else -%}
                {{ 'collection-' | append: forloop.index | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </div>
            <h3 class="collection-tile__title">
              <span class="link-underline">
                {%- if collection != blank -%}
                  {{ collection.title | escape }}
                {%- else -%}
                  {{ 'onboarding.collection_title' | t }}
                {%- endif -%}
              </span>
              {% render 'icon', icon: 'arrow' %}
            </h3>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.collection_list.name",
  "tag": "div",
  "class": "section",
  "max_blocks": 12,
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "inline_richtext", "id": "heading", "default": "Shop the house", "label": "t:sections.all.heading" },
    { "type": "range", "id": "columns_desktop", "min": 2, "max": 4, "step": 1, "default": 3, "label": "t:sections.all.columns_desktop" },
    {
      "type": "select",
      "id": "image_ratio",
      "default": "portrait",
      "label": "t:sections.all.image_ratio.label",
      "options": [
        { "value": "portrait", "label": "t:sections.all.image_ratio.options.portrait" },
        { "value": "square", "label": "t:sections.all.image_ratio.options.square" },
        { "value": "landscape", "label": "t:sections.all.image_ratio.options.landscape" }
      ]
    },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.color_scheme.label", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "t:sections.all.padding_top", "default": 96 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "t:sections.all.padding_bottom", "default": 96 }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "t:sections.collection_list.blocks.collection.name",
      "settings": [
        { "type": "collection", "id": "collection", "label": "t:sections.collection_list.blocks.collection.settings.collection.label" },
        { "type": "image_picker", "id": "image", "label": "t:sections.all.image", "info": "t:sections.collection_list.blocks.collection.settings.image.info" }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.collection_list.presets.name",
      "blocks": [{ "type": "collection" }, { "type": "collection" }, { "type": "collection" }]
    }
  ]
}
{% endschema %}
