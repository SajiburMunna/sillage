{{ 'section-pages.css' | asset_url | stylesheet_tag }}

<section class="section-padding color-{{ section.settings.color_scheme }}" style="--pad-top: 96px; --pad-bottom: 96px;">
  <div class="page-width page-width--narrow password-page">
    {%- if settings.logo != blank -%}
      {{ settings.logo | image_url: width: 600 | image_tag: class: 'header__logo-image', widths: '150, 300, 600', sizes: '240px', alt: shop.name }}
    {%- else -%}
      <span class="header__logo-text">{{ shop.name }}</span>
    {%- endif -%}
    <h1 class="h-display h-display--md password-page__title">{{ section.settings.heading }}</h1>
    {%- if shop.password_message != blank -%}
      <p>{{ shop.password_message }}</p>
    {%- endif -%}

    <div class="password-page__form">
      {% render 'newsletter-form', form_id: 'PasswordNewsletter' %}
    </div>

    <details class="accordion password-page__login">
      <summary>{{ 'general.password_page.login_password_button' | t }} {% render 'icon', icon: 'caret' %}</summary>
      <div class="accordion__content">
        {%- form 'storefront_password', class: 'password-form' -%}
          <div class="field">
            <label for="Password" class="field__label">{{ 'general.password_page.login_form_password_label' | t }}</label>
            <input type="password" name="password" id="Password" autocomplete="current-password" {% if form.errors %}aria-invalid="true" aria-describedby="PasswordLoginForm-error"{% endif %}>
          </div>
          {%- if form.errors -%}
            <p class="form__message form__message--error" id="PasswordLoginForm-error" role="alert">{{ form.errors.messages.form }}</p>
          {%- endif -%}
          <button type="submit" class="button button--full">{{ 'general.password_page.login_form_submit' | t }}</button>
        {%- endform -%}
      </div>
    </details>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.main_password.name",
  "tag": "div",
  "class": "section",
  "settings": [
    { "type": "inline_richtext", "id": "heading", "default": "Something new is in the air", "label": "t:sections.all.heading" },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.color_scheme.label", "default": "scheme-1" }
  ]
}
{% endschema %}
