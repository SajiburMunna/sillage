<section
  class="section-padding color-{{ section.settings.color_scheme }}"
  style="--pad-top: {{ section.settings.padding_top }}px; --pad-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="page-width page-width--narrow">
    {%- if section.settings.heading != blank -%}
      <h2 class="h-display h-display--md" data-reveal>{{ section.settings.heading }}</h2>
    {%- endif -%}
    <div data-reveal>
      {%- for block in section.blocks -%}
        <details class="accordion" {{ block.shopify_attributes }}{% if section.settings.open_first and forloop.first %} open{% endif %}>
          <summary>{{ block.settings.heading | escape }} {% render 'icon', icon: 'caret' %}</summary>
          <div class="accordion__content rte">
            {{ block.settings.row_content }}
            {{ block.settings.page.content }}
          </div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.collapsible_content.name",
  "tag": "div",
  "class": "section",
  "settings": [
    { "type": "inline_richtext", "id": "heading", "default": "Questions, answered", "label": "t:sections.all.heading" },
    { "type": "checkbox", "id": "open_first", "default": false, "label": "t:sections.collapsible_content.settings.open_first.label" },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.color_scheme.label", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "t:sections.all.padding_top", "default": 96 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "t:sections.all.padding_bottom", "default": 96 }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "t:sections.collapsible_content.blocks.row.name",
      "settings": [
        { "type": "text", "id": "heading", "default": "How long does the scent last?", "label": "t:sections.all.heading" },
        { "type": "richtext", "id": "row_content", "default": "<p>Use this row to answer a common question about longevity, ingredients, shipping or returns.</p>", "label": "t:sections.collapsible_content.blocks.row.settings.row_content.label" },
        { "type": "page", "id": "page", "label": "t:sections.collapsible_content.blocks.row.settings.page.label" }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.collapsible_content.presets.name",
      "blocks": [
        { "type": "row" },
        { "type": "row", "settings": { "heading": "Is it safe for sensitive skin?" } },
        { "type": "row", "settings": { "heading": "Do you offer samples?" } }
      ]
    }
  ]
}
{% endschema %}
