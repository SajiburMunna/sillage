<section
  class="multicolumn section-padding color-{{ section.settings.color_scheme }}"
  style="--pad-top: {{ section.settings.padding_top }}px; --pad-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="page-width">
    {%- if section.settings.heading != blank or section.settings.eyebrow != blank -%}
      <div class="section-header multicolumn__header multicolumn__header--{{ section.settings.alignment }}" data-reveal>
        <div>
          {%- if section.settings.eyebrow != blank -%}
            <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h2 class="section-header__title h-display h-display--md">{{ section.settings.heading }}</h2>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}

    <ul
      class="grid multicolumn__list multicolumn__list--{{ section.settings.alignment }} multicolumn__list--{{ section.settings.style }}"
      role="list"
      style="--cols: {{ section.settings.columns_desktop }}; --cols-tablet: {{ section.settings.columns_desktop | at_most: 3 }}; --cols-mobile: {{ section.settings.columns_mobile }};"
    >
      {%- for block in section.blocks -%}
        <li class="multicolumn__item" data-reveal style="--delay: {{ forloop.index0 | modulo: 4 | times: 0.08 }}s;" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <div class="multicolumn__media media media--{{ section.settings.image_ratio }}">
              {{
                block.settings.image
                | image_url: width: 1200
                | image_tag:
                  widths: '360, 540, 720, 900, 1200',
                  sizes: '(min-width: 990px) 33vw, (min-width: 750px) 50vw, 100vw',
                  loading: 'lazy',
                  alt: block.settings.image.alt
              }}
            </div>
          {%- elsif block.settings.icon != 'none' -%}
            <span class="multicolumn__icon">{% render 'icon', icon: block.settings.icon %}</span>
          {%- endif -%}
          {%- if block.settings.title != blank -%}
            <h3 class="multicolumn__title">{{ block.settings.title }}</h3>
          {%- endif -%}
          {%- if block.settings.text != blank -%}
            <div class="rte multicolumn__text">{{ block.settings.text }}</div>
          {%- endif -%}
          {%- if block.settings.link_label != blank and block.settings.link != blank -%}
            <a href="{{ block.settings.link }}" class="button button--tertiary multicolumn__link">
              {{- block.settings.link_label | escape }}
              {% render 'icon', icon: 'arrow' %}
            </a>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>

    {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
      <div class="multicolumn__footer multicolumn__header--{{ section.settings.alignment }}">
        <a href="{{ section.settings.button_link }}" class="button button--secondary">{{ section.settings.button_label | escape }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .multicolumn__header--center {
    justify-content: center;
    text-align: center;
  }
  .multicolumn__header--center .eyebrow {
    justify-content: center;
  }
  .multicolumn__list {
    --grid-gap: clamp(2.4rem, 3vw, 4rem);
  }
  .multicolumn__item {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.2rem;
  }
  .multicolumn__list--center .multicolumn__item {
    align-items: center;
    text-align: center;
  }
  .multicolumn__list--card .multicolumn__item {
    padding: clamp(2.4rem, 3vw, 3.6rem);
    border-radius: var(--radius);
    background: rgb(var(--color-surface));
  }
  .multicolumn__list--divided .multicolumn__item {
    padding-top: 2.4rem;
    border-top: 1px solid rgba(var(--color-foreground), 0.18);
  }
  .multicolumn__media {
    width: 100%;
    margin-bottom: 0.8rem;
  }
  .multicolumn__icon {
    display: grid;
    place-items: center;
    width: 5.6rem;
    height: 5.6rem;
    margin-bottom: 0.4rem;
    border-radius: 50%;
    border: 1px solid rgba(var(--color-accent), 0.35);
    color: rgb(var(--color-accent));
  }
  .multicolumn__icon .icon {
    width: 2.6rem;
    height: 2.6rem;
  }
  .multicolumn__title {
    margin: 0;
    font-size: calc(var(--font-heading-scale) * 2.2rem);
    line-height: 1.2;
  }
  .multicolumn__text {
    color: rgba(var(--color-foreground), 0.78);
    font-size: 1.5rem;
  }
  .multicolumn__link {
    margin-top: auto;
  }
  .multicolumn__footer {
    display: flex;
    margin-top: 4.8rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.multicolumn.name",
  "tag": "div",
  "class": "section",
  "max_blocks": 8,
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "default": "Why Sillage",
      "label": "t:sections.all.eyebrow"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "Made slowly, worn for hours",
      "label": "t:sections.all.heading"
    },
    {
      "type": "select",
      "id": "style",
      "default": "plain",
      "label": "t:sections.multicolumn.settings.style.label",
      "options": [
        {
          "value": "plain",
          "label": "t:sections.multicolumn.settings.style.options.plain"
        },
        {
          "value": "card",
          "label": "t:sections.multicolumn.settings.style.options.card"
        },
        {
          "value": "divided",
          "label": "t:sections.multicolumn.settings.style.options.divided"
        }
      ]
    },
    {
      "type": "select",
      "id": "alignment",
      "default": "left",
      "label": "t:sections.all.alignment",
      "options": [
        {
          "value": "left",
          "label": "t:sections.all.alignment_options.left"
        },
        {
          "value": "center",
          "label": "t:sections.all.alignment_options.center"
        }
      ]
    },
    {
      "type": "select",
      "id": "image_ratio",
      "default": "portrait",
      "label": "t:sections.all.image_ratio.label",
      "options": [
        {
          "value": "portrait",
          "label": "t:sections.all.image_ratio.options.portrait"
        },
        {
          "value": "square",
          "label": "t:sections.all.image_ratio.options.square"
        },
        {
          "value": "landscape",
          "label": "t:sections.all.image_ratio.options.landscape"
        }
      ]
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4,
      "label": "t:sections.all.columns_desktop"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "default": "1",
      "label": "t:sections.all.columns_mobile",
      "options": [
        {
          "value": "1",
          "label": "t:sections.all.columns_mobile_options.one"
        },
        {
          "value": "2",
          "label": "t:sections.all.columns_mobile_options.two"
        }
      ]
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:sections.all.button_label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:sections.all.button_link"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.color_scheme.label",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding_top",
      "default": 88
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding_bottom",
      "default": 88
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "t:sections.multicolumn.blocks.column.name",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "default": "vial",
          "label": "t:sections.all.icon.label",
          "info": "t:sections.multicolumn.blocks.column.settings.icon.info",
          "options": [
            {
              "value": "none",
              "label": "t:sections.all.icon.options.none"
            },
            {
              "value": "truck",
              "label": "t:sections.all.icon.options.truck"
            },
            {
              "value": "gift",
              "label": "t:sections.all.icon.options.gift"
            },
            {
              "value": "leaf",
              "label": "t:sections.all.icon.options.leaf"
            },
            {
              "value": "return",
              "label": "t:sections.all.icon.options.return"
            },
            {
              "value": "lock",
              "label": "t:sections.all.icon.options.lock"
            },
            {
              "value": "bottle",
              "label": "t:sections.all.icon.options.bottle"
            },
            {
              "value": "vial",
              "label": "t:sections.all.icon.options.vial"
            },
            {
              "value": "droplet",
              "label": "t:sections.all.icon.options.droplet"
            },
            {
              "value": "heart",
              "label": "t:sections.all.icon.options.heart"
            },
            {
              "value": "clock",
              "label": "t:sections.all.icon.options.clock"
            },
            {
              "value": "chat",
              "label": "t:sections.all.icon.options.chat"
            }
          ]
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.all.image"
        },
        {
          "type": "inline_richtext",
          "id": "title",
          "default": "Column title",
          "label": "t:sections.all.heading"
        },
        {
          "type": "richtext",
          "id": "text",
          "default": "<p>Share a detail that helps shoppers choose, such as ingredients, sourcing or service.</p>",
          "label": "t:sections.all.text"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "t:sections.multicolumn.blocks.column.settings.link_label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.all.link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.multicolumn.presets.name",
      "blocks": [
        {
          "type": "column",
          "settings": {
            "icon": "leaf",
            "title": "Clean ingredients",
            "text": "<p>Vegan, cruelty-free and made without phthalates.</p>"
          }
        },
        {
          "type": "column",
          "settings": {
            "icon": "droplet",
            "title": "Long-lasting",
            "text": "<p>Extrait concentration that stays with you from morning to evening.</p>"
          }
        },
        {
          "type": "column",
          "settings": {
            "icon": "vial",
            "title": "Free samples",
            "text": "<p>Try two scents with every order before you commit.</p>"
          }
        },
        {
          "type": "column",
          "settings": {
            "icon": "return",
            "title": "Easy returns",
            "text": "<p>Changed your mind? Return within 30 days, even if opened.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
