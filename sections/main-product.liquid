{{ 'section-product.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign featured_media = current_variant.featured_media | default: product.featured_media
  assign tint = product.metafields.custom.tint.value | default: product.metafields.custom.tint
-%}

<section
  id="MainProduct-{{ section.id }}"
  class="product section-padding color-{{ section.settings.color_scheme }}{% if tint != blank %} product--tinted{% endif %}"
  style="--pad-top: {{ section.settings.padding_top }}px; --pad-bottom: {{ section.settings.padding_bottom }}px;{% if tint != blank %} --tint: {{ tint }};{% endif %}"
  data-product-root
  data-section="{{ section.id }}"
  data-viewed-handle="{{ product.handle }}"
>
  {%- if section.settings.show_breadcrumbs -%}
    <div class="page-width">{% render 'breadcrumbs' %}</div>
  {%- endif -%}
  <div class="page-width product__grid{% if section.settings.media_layout == 'carousel' %} product__grid--carousel{% endif %}">
    {%- comment -%} Media {%- endcomment -%}
    <media-gallery class="product__media" aria-label="{{ 'products.product.media.gallery_viewer' | t }}">
      <ul class="product__media-list" role="list" data-gallery-viewer>
        {%- if featured_media -%}
          <li class="product__media-item is-active" data-media-id="{{ featured_media.id }}">
            {% render 'product-media', media: featured_media, loading: 'eager', sizes: '(min-width: 990px) 55vw, 100vw' %}
            {%- if section.settings.enable_zoom and featured_media.media_type == 'image' -%}
              <button type="button" class="product__zoom" data-lightbox-open="{{ featured_media.id }}" aria-haspopup="dialog" aria-label="{{ 'products.product.media.open_zoom' | t }}">
                {% render 'icon', icon: 'zoom' %}
              </button>
            {%- endif -%}
          </li>
        {%- endif -%}
        {%- for media in product.media -%}
          {%- unless media.id == featured_media.id -%}
            <li class="product__media-item" data-media-id="{{ media.id }}">
              {% render 'product-media', media: media, loading: 'lazy', sizes: '(min-width: 990px) 55vw, 100vw' %}
              {%- if section.settings.enable_zoom and media.media_type == 'image' -%}
              <button type="button" class="product__zoom" data-lightbox-open="{{ media.id }}" aria-haspopup="dialog" aria-label="{{ 'products.product.media.open_zoom' | t }}">
                {% render 'icon', icon: 'zoom' %}
              </button>
            {%- endif -%}
            </li>
          {%- endunless -%}
        {%- endfor -%}
        {%- if product.media.size == 0 -%}
          <li class="product__media-item is-active">
            <div class="media media--portrait">{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}</div>
          </li>
        {%- endif -%}
      </ul>
      {%- if product.media.size > 1 -%}
        <ul class="product__thumbs" role="list">
          {%- for media in product.media -%}
            <li>
              <button
                type="button"
                class="product__thumb media"
                data-gallery-thumb
                data-media-id="{{ media.id }}"
                aria-current="{% if media.id == featured_media.id %}true{% else %}false{% endif %}"
                aria-label="{{ 'products.product.media.load_image' | t: index: forloop.index }}"
              >
                {{ media.preview_image | image_url: width: 160 | image_tag: loading: 'lazy', alt: '', widths: '80, 160', sizes: '80px' }}
              </button>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
      {%- assign first_3d_model = product.media | where: 'media_type', 'model' | first -%}
      {%- if first_3d_model -%}
        <button type="button" class="button button--secondary button--small product__xr" data-shopify-xr data-shopify-model3d-id="{{ first_3d_model.id }}" data-shopify-title="{{ product.title | escape }}" data-shopify-xr-hidden>
          {{ 'products.product.media.view_in_space' | t }}
        </button>
        <script type="application/json" id="ProductJSON-{{ product.id }}">
          {{ product.media | where: 'media_type', 'model' | json }}
        </script>
      {%- endif -%}
    </media-gallery>

    {%- if section.settings.enable_zoom -%}
      {%- assign zoom_images = product.media | where: 'media_type', 'image' -%}
      {%- if zoom_images.size > 0 -%}
        <media-lightbox class="lightbox" data-section="{{ section.id }}">
          <dialog class="lightbox__dialog color-{{ section.settings.color_scheme }}" aria-label="{{ 'products.product.media.zoom_viewer' | t: title: product.title | escape }}">
            <div class="lightbox__toolbar">
              <p class="lightbox__counter" data-lightbox-counter aria-live="polite"></p>
              <button type="button" class="icon-button lightbox__close" data-lightbox-close aria-label="{{ 'accessibility.close' | t }}">
                {% render 'icon', icon: 'close' %}
              </button>
            </div>
            <ul class="lightbox__track" role="list" data-lightbox-track>
              {%- for media in zoom_images -%}
                <li class="lightbox__slide" data-media-id="{{ media.id }}">
                  <button type="button" class="lightbox__zoom" data-lightbox-zoom aria-pressed="false" aria-label="{{ 'products.product.media.toggle_zoom' | t }}">
                    {{
                      media
                      | image_url: width: 2400
                      | image_tag:
                        widths: '900, 1400, 1800, 2400',
                        sizes: '100vw',
                        loading: 'lazy',
                        alt: media.alt,
                        class: 'lightbox__image'
                    }}
                  </button>
                </li>
              {%- endfor -%}
            </ul>
            {%- if zoom_images.size > 1 -%}
              <button type="button" class="icon-button lightbox__nav lightbox__nav--prev" data-lightbox-prev aria-label="{{ 'products.product.media.previous' | t }}">
                {% render 'icon', icon: 'arrow-left' %}
              </button>
              <button type="button" class="icon-button lightbox__nav lightbox__nav--next" data-lightbox-next aria-label="{{ 'products.product.media.next' | t }}">
                {% render 'icon', icon: 'arrow' %}
              </button>
            {%- endif -%}
          </dialog>
        </media-lightbox>
      {%- endif -%}
    {%- endif -%}

    {%- comment -%} Info {%- endcomment -%}
    <div class="product__info">
      <div class="product__info-sticky">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when '@app' -%}
              {% render block %}
            {%- when 'text' -%}
              <p class="product__text {{ block.settings.style }}" {{ block.shopify_attributes }}>{{ block.settings.text }}</p>
            {%- when 'vendor' -%}
              <p class="card__vendor" {{ block.shopify_attributes }}>{{ product.vendor | escape }}</p>
            {%- when 'title' -%}
              <h1 class="product__title h1" {{ block.shopify_attributes }}>{{ product.title | escape }}</h1>
            {%- when 'price' -%}
              <div class="product__price" {{ block.shopify_attributes }}>
                <div data-product-update="price">
                  {% render 'price', product: product, use_variant: true, show_badges: true, class: 'price--large' %}
                </div>
                {%- if cart.taxes_included or shop.shipping_policy.body != blank -%}
                  <p class="product__tax text-muted">
                    {%- if cart.duties_included and cart.taxes_included -%}
                      {{ 'products.product.duties_and_taxes_included' | t }}
                    {%- elsif cart.taxes_included -%}
                      {{ 'products.product.taxes_included' | t }}
                    {%- endif -%}
                    {%- if shop.shipping_policy.body != blank %}
                      {{ 'products.product.shipping_policy_html' | t: link: shop.shipping_policy.url }}
                    {%- endif -%}
                  </p>
                {%- endif -%}
                <div class="product__installments" data-product-update="installments">
                  {%- assign installments_form_id = 'InstallmentsForm-' | append: section.id -%}
                  {%- form 'product', product, id: installments_form_id -%}
                    <input type="hidden" name="id" value="{{ current_variant.id }}">
                    {{ form | payment_terms }}
                  {%- endform -%}
                </div>
              </div>
            {%- when 'variant_picker' -%}
              {% render 'variant-picker', product: product, block: block, section_id: section.id %}
            {%- when 'buy_buttons' -%}
              {% render 'buy-buttons', product: product, block: block, section_id: section.id, show_quantity: block.settings.show_quantity %}
            {%- when 'inventory' -%}
              <p class="product__inventory" data-product-update="inventory" {{ block.shopify_attributes }}>
                {%- if current_variant.inventory_management == 'shopify' and current_variant.available -%}
                  {%- if current_variant.inventory_quantity <= block.settings.threshold and current_variant.inventory_quantity > 0 -%}
                    <span class="product__stock product__stock--low">{{ 'products.product.inventory_low_stock_show_count' | t: quantity: current_variant.inventory_quantity }}</span>
                  {%- else -%}
                    <span class="product__stock">{{ 'products.product.inventory_in_stock' | t }}</span>
                  {%- endif -%}
                {%- endif -%}
              </p>
            {%- when 'notes' -%}
              {%- liquid
                assign mf = product.metafields.custom
                assign note_list = mf.notes.value | default: mf.notes
                if note_list == blank
                  assign top_first = mf.top_notes.value | split: ',' | first
                  assign heart_first = mf.heart_notes.value | split: ',' | first
                  assign base_first = mf.base_notes.value | split: ',' | first
                  assign note_list = top_first | append: ',' | append: heart_first | append: ',' | append: base_first
                endif
                assign note_items = note_list | split: ','
              -%}
              {%- capture chips -%}
                {%- for note in note_items limit: 6 -%}
                  {%- assign note_name = note | strip -%}
                  {%- if note_name != blank -%}
                    <li><a class="note-chip" href="{{ routes.search_url }}?q={{ note_name | url_encode }}&type=product">{{ note_name | escape }}</a></li>
                  {%- endif -%}
                {%- endfor -%}
              {%- endcapture -%}
              {%- if chips != blank -%}
                <ul class="note-chips product__notes" role="list" aria-label="{{ 'products.product.notes_label' | t }}" {{ block.shopify_attributes }}>{{ chips }}</ul>
              {%- endif -%}
            {%- when 'delivery' -%}
              <div class="product__delivery" data-product-update="delivery" {{ block.shopify_attributes }}>
                {%- if current_variant.available -%}
                  <delivery-estimate
                    class="product__delivery-inner"
                    data-min="{{ block.settings.min_days }}"
                    data-max="{{ block.settings.max_days }}"
                    data-weekends="{{ block.settings.skip_weekends }}"
                    data-cutoff="{{ block.settings.cutoff_hour }}"
                    data-locale="{{ request.locale.iso_code }}"
                    data-template="{{ 'products.product.delivery_estimate' | t | escape }}"
                    data-template-single="{{ 'products.product.delivery_estimate_single' | t | escape }}"
                    hidden
                  >
                    {% render 'icon', icon: 'truck' %}
                    <span data-delivery-text></span>
                  </delivery-estimate>
                {%- endif -%}
              </div>
            {%- when 'description' -%}
              {%- if product.description != blank -%}
                <div class="product__description rte" {{ block.shopify_attributes }}>{{ product.description }}</div>
              {%- endif -%}
            {%- when 'fragrance_notes' -%}
              {% render 'fragrance-notes', block: block, product: product %}
            {%- when 'collapsible_tab' -%}
              <details class="accordion" {{ block.shopify_attributes }}>
                <summary>{{ block.settings.heading | default: block.settings.page.title | escape }} {% render 'icon', icon: 'caret' %}</summary>
                <div class="accordion__content rte">
                  {{ block.settings.content }}
                  {{ block.settings.page.content }}
                </div>
              </details>
            {%- when 'share' -%}
              <share-button class="product__share" data-url="{{ request.origin }}{{ product.url }}" data-title="{{ product.title | escape }}" {{ block.shopify_attributes }}>
                <button type="button" class="link product__share-button">
                  {% render 'icon', icon: 'share' %}
                  <span data-share-label>{{ block.settings.share_label | escape }}</span>
                </button>
                <span class="visually-hidden" role="status" data-share-status data-success="{{ 'general.share.success_message' | t | escape }}"></span>
              </share-button>
            {%- when 'trust' -%}
              <ul class="product__trust" role="list" {{ block.shopify_attributes }}>
                {%- for i in (1..3) -%}
                  {%- assign text_key = 'text_' | append: i -%}
                  {%- assign icon_key = 'icon_' | append: i -%}
                  {%- if block.settings[text_key] != blank -%}
                    <li class="product__trust-item">
                      {% render 'icon', icon: block.settings[icon_key] %}
                      <span>{{ block.settings[text_key] }}</span>
                    </li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            {%- when 'custom_liquid' -%}
              <div {{ block.shopify_attributes }}>{{ block.settings.custom_liquid }}</div>
            {%- when 'complementary' -%}
              <div class="product__complementary" {{ block.shopify_attributes }}>
                <product-recommendations data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ block.settings.product_count }}&intent=complementary">
                  {%- if recommendations.performed and recommendations.products_count > 0 -%}
                    <h2 class="eyebrow">{{ block.settings.heading | escape }}</h2>
                    <ul class="product__complementary-list" role="list">
                      {%- for rec in recommendations.products -%}
                        <li class="product__complementary-item">
                          <a href="{{ rec.url }}" class="media media--square" tabindex="-1" aria-hidden="true">
                            {%- if rec.featured_media -%}
                              {{ rec.featured_media | image_url: width: 160 | image_tag: loading: 'lazy', widths: '80, 160', sizes: '80px', alt: '' }}
                            {%- endif -%}
                          </a>
                          <div>
                            <a href="{{ rec.url }}" class="link-underline">{{ rec.title | escape }}</a>
                            {% render 'price', product: rec %}
                          </div>
                        </li>
                      {%- endfor -%}
                    </ul>
                  {%- endif -%}
                </product-recommendations>
              </div>
          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>
  </div>

  <script type="application/json" data-selected-variant hidden>
    {{ current_variant | json }}
  </script>

  {%- if section.settings.show_sticky_cart and product.available -%}
    <sticky-atc class="sticky-atc color-{{ section.settings.color_scheme }}" data-form="ProductForm-{{ section.id }}" hidden>
      <div class="page-width sticky-atc__inner">
        <div class="sticky-atc__product">
          {%- if featured_media -%}
            {{ featured_media.preview_image | image_url: width: 120 | image_tag: loading: 'lazy', widths: '60, 120', sizes: '48px', alt: '', class: 'sticky-atc__image' }}
          {%- endif -%}
          <div>
            <p class="sticky-atc__title">{{ product.title | escape }}</p>
            <div class="sticky-atc__price" data-product-update="sticky-price">
              {% render 'price', product: product, use_variant: true %}
            </div>
          </div>
        </div>
        <button type="submit" form="ProductForm-{{ section.id }}" name="add" class="button sticky-atc__button" data-product-update-button>
          {{ 'products.product.add_to_cart' | t }}
        </button>
      </div>
    </sticky-atc>
  {%- endif -%}
</section>

<script type="application/ld+json">
  {{ product | structured_data }}
</script>

{% schema %}
{
  "name": "t:sections.main_product.name",
  "tag": "div",
  "class": "section",
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "text",
      "name": "t:sections.main_product.blocks.text.name",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "text",
          "default": "Text block",
          "label": "t:sections.main_product.blocks.text.settings.text.label"
        },
        {
          "type": "select",
          "id": "style",
          "default": "eyebrow",
          "label": "t:sections.main_product.blocks.text.settings.style.label",
          "options": [
            {
              "value": "eyebrow",
              "label": "t:sections.main_product.blocks.text.settings.style.options__1.label"
            },
            {
              "value": "text-muted",
              "label": "t:sections.main_product.blocks.text.settings.style.options__2.label"
            }
          ]
        }
      ]
    },
    {
      "type": "vendor",
      "name": "t:sections.main_product.blocks.vendor.name",
      "limit": 1
    },
    {
      "type": "title",
      "name": "t:sections.main_product.blocks.title.name",
      "limit": 1
    },
    {
      "type": "price",
      "name": "t:sections.main_product.blocks.price.name",
      "limit": 1
    },
    {
      "type": "variant_picker",
      "name": "t:sections.main_product.blocks.variant_picker.name",
      "limit": 1,
      "settings": [
        {
          "type": "select",
          "id": "picker_type",
          "default": "buttons",
          "label": "t:sections.main_product.blocks.variant_picker.settings.picker_type.label",
          "options": [
            {
              "value": "buttons",
              "label": "t:sections.main_product.blocks.variant_picker.settings.picker_type.options__1.label"
            },
            {
              "value": "dropdown",
              "label": "t:sections.main_product.blocks.variant_picker.settings.picker_type.options__2.label"
            }
          ]
        }
      ]
    },
    {
      "type": "buy_buttons",
      "name": "t:sections.main_product.blocks.buy_buttons.name",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_quantity",
          "default": true,
          "label": "t:sections.main_product.blocks.buy_buttons.settings.show_quantity.label"
        },
        {
          "type": "checkbox",
          "id": "show_dynamic_checkout",
          "default": true,
          "label": "t:sections.main_product.blocks.buy_buttons.settings.show_dynamic_checkout.label",
          "info": "t:sections.main_product.blocks.buy_buttons.settings.show_dynamic_checkout.info"
        },
        {
          "type": "checkbox",
          "id": "show_gift_card_recipient",
          "default": true,
          "label": "t:sections.main_product.blocks.buy_buttons.settings.show_gift_card_recipient.label"
        },
        {
          "type": "checkbox",
          "id": "show_pickup_availability",
          "default": true,
          "label": "t:sections.main_product.blocks.buy_buttons.settings.show_pickup_availability.label"
        }
      ]
    },
    {
      "type": "notes",
      "name": "t:sections.main_product.blocks.notes.name",
      "limit": 1,
      "settings": [
        {
          "type": "paragraph",
          "content": "t:sections.main_product.blocks.notes.settings.paragraph.content"
        }
      ]
    },
    {
      "type": "delivery",
      "name": "t:sections.main_product.blocks.delivery.name",
      "limit": 1,
      "settings": [
        {
          "type": "range",
          "id": "min_days",
          "min": 0,
          "max": 30,
          "step": 1,
          "default": 2,
          "label": "t:sections.main_product.blocks.delivery.settings.min_days.label"
        },
        {
          "type": "range",
          "id": "max_days",
          "min": 0,
          "max": 30,
          "step": 1,
          "default": 5,
          "label": "t:sections.main_product.blocks.delivery.settings.max_days.label"
        },
        {
          "type": "checkbox",
          "id": "skip_weekends",
          "default": true,
          "label": "t:sections.main_product.blocks.delivery.settings.skip_weekends.label"
        },
        {
          "type": "range",
          "id": "cutoff_hour",
          "min": 0,
          "max": 23,
          "step": 1,
          "default": 14,
          "unit": "h",
          "label": "t:sections.main_product.blocks.delivery.settings.cutoff_hour.label",
          "info": "t:sections.main_product.blocks.delivery.settings.cutoff_hour.info"
        }
      ]
    },
    {
      "type": "inventory",
      "name": "t:sections.main_product.blocks.inventory.name",
      "limit": 1,
      "settings": [
        {
          "type": "range",
          "id": "threshold",
          "min": 1,
          "max": 20,
          "step": 1,
          "default": 5,
          "label": "t:sections.main_product.blocks.inventory.settings.threshold.label"
        }
      ]
    },
    {
      "type": "description",
      "name": "t:sections.main_product.blocks.description.name",
      "limit": 1
    },
    {
      "type": "fragrance_notes",
      "name": "t:sections.main_product.blocks.fragrance_notes.name",
      "limit": 1,
      "settings": [
        {
          "type": "paragraph",
          "content": "t:sections.main_product.blocks.fragrance_notes.settings.paragraph.content"
        },
        {
          "type": "text",
          "id": "heading",
          "default": "Fragrance notes",
          "label": "t:sections.main_product.blocks.fragrance_notes.settings.heading.label"
        },
        {
          "type": "text",
          "id": "top_notes",
          "label": "t:sections.main_product.blocks.fragrance_notes.settings.top_notes.label"
        },
        {
          "type": "text",
          "id": "heart_notes",
          "label": "t:sections.main_product.blocks.fragrance_notes.settings.heart_notes.label"
        },
        {
          "type": "text",
          "id": "base_notes",
          "label": "t:sections.main_product.blocks.fragrance_notes.settings.base_notes.label"
        },
        {
          "type": "range",
          "id": "intensity",
          "min": 0,
          "max": 5,
          "step": 1,
          "default": 3,
          "label": "t:sections.main_product.blocks.fragrance_notes.settings.intensity.label",
          "info": "t:sections.main_product.blocks.fragrance_notes.settings.intensity.info"
        }
      ]
    },
    {
      "type": "collapsible_tab",
      "name": "t:sections.main_product.blocks.collapsible_tab.name",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "default": "How to wear",
          "label": "t:sections.main_product.blocks.collapsible_tab.settings.heading.label"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "t:sections.main_product.blocks.collapsible_tab.settings.content.label"
        },
        {
          "type": "page",
          "id": "page",
          "label": "t:sections.main_product.blocks.collapsible_tab.settings.page.label"
        }
      ]
    },
    {
      "type": "share",
      "name": "t:sections.main_product.blocks.share.name",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "share_label",
          "default": "Share",
          "label": "t:sections.main_product.blocks.share.settings.share_label.label"
        }
      ]
    },
    {
      "type": "complementary",
      "name": "t:sections.main_product.blocks.complementary.name",
      "limit": 1,
      "settings": [
        {
          "type": "paragraph",
          "content": "t:sections.main_product.blocks.complementary.settings.paragraph.content"
        },
        {
          "type": "text",
          "id": "heading",
          "default": "Layer it with",
          "label": "t:sections.main_product.blocks.complementary.settings.heading.label"
        },
        {
          "type": "range",
          "id": "product_count",
          "min": 1,
          "max": 6,
          "step": 1,
          "default": 3,
          "label": "t:sections.main_product.blocks.complementary.settings.product_count.label"
        }
      ]
    },
    {
      "type": "trust",
      "name": "t:sections.main_product.blocks.trust.name",
      "limit": 2,
      "settings": [
        {
          "type": "select",
          "id": "icon_1",
          "default": "truck",
          "label": "t:sections.all.icon.label",
          "options": [
