<div
  class="section-padding color-{{ section.settings.color_scheme }}"
  style="--pad-top: {{ section.settings.padding_top }}px; --pad-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="page-width">
    {{ section.settings.custom_liquid }}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.all.custom_liquid.name",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "liquid", "id": "custom_liquid", "label": "t:sections.all.custom_liquid.label", "info": "t:sections.all.custom_liquid.info" },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.color_scheme.label", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "t:sections.all.padding_top", "default": 40 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "t:sections.all.padding_bottom", "default": 40 }
  ],
  "presets": [{ "name": "t:sections.all.custom_liquid.name" }]
}
{% endschema %}
