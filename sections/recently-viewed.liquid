<div
  class="section-padding color-{{ section.settings.color_scheme }}"
  style="--pad-top: {{ section.settings.padding_top }}px; --pad-bottom: {{ section.settings.padding_bottom }}px;"
>
  <recently-viewed class="page-width" data-limit="{{ section.settings.limit }}" data-current="{{ product.handle }}" hidden>
    <div class="section-header">
      <h2 class="section-header__title h2">{{ section.settings.heading | escape }}</h2>
    </div>
    <ul class="grid" role="list" style="--cols: {{ section.settings.limit }}; --cols-tablet: 3; --cols-mobile: 2;" data-rv-list></ul>
  </recently-viewed>
</div>
<script src="{{ 'marketing.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "t:sections.recently_viewed.name",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "heading", "default": "Recently viewed", "label": "t:sections.all.heading" },
    { "type": "range", "id": "limit", "min": 2, "max": 5, "step": 1, "default": 4, "label": "t:sections.all.products_to_show" },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.color_scheme.label", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "t:sections.all.padding_top", "default": 48 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "t:sections.all.padding_bottom", "default": 72 }
  ],
  "presets": [{ "name": "t:sections.recently_viewed.presets.name" }]
}
{% endschema %}
