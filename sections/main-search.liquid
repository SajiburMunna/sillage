{{ 'section-collection.css' | asset_url | stylesheet_tag }}
{{ 'section-pages.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign type_param = ''
  for p in search.types
    assign type_param = type_param | append: p | append: ','
  endfor
  assign type_param = type_param | remove_last: ','
  assign is_products = false
  assign is_other = false
  if type_param == 'product'
    assign is_products = true
  elsif type_param == 'article,page' or type_param == 'page,article'
    assign is_other = true
  endif
  assign q = search.terms | url_encode
-%}

<section
  class="search-page section-padding color-{{ section.settings.color_scheme }}"
  style="--pad-top: {{ section.settings.padding_top }}px; --pad-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="page-width">
    <header class="search-page__hero">
      <h1 class="h-display h-display--md search-page__title">
        {%- if search.performed -%}{{ search.terms | escape }}{%- else -%}{{ 'templates.search.title' | t }}{%- endif -%}
      </h1>
      <form action="{{ routes.search_url }}" method="get" role="search" class="search-page__form">
        <label class="visually-hidden" for="Search-In-Template">{{ 'general.search.search' | t }}</label>
        <span class="search-page__icon" aria-hidden="true">{% render 'icon', icon: 'search' %}</span>
        <input id="Search-In-Template" class="search-page__input" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'general.search.placeholder' | t }}" autocomplete="off">
        <input name="options[prefix]" type="hidden" value="last">
        {%- if type_param != blank -%}<input name="type" type="hidden" value="{{ type_param }}">{%- endif -%}
        <button type="submit" class="button">{{ 'general.search.submit' | t }}</button>
      </form>

      {%- if search.performed -%}
        <nav class="search-page__types" aria-label="{{ 'templates.search.types_label' | t }}">
          <a href="{{ routes.search_url }}?q={{ q }}&options%5Bprefix%5D=last" class="blog-tags__tag"{% unless is_products or is_other %} aria-current="page"{% endunless %}>{{ 'templates.search.tab_all' | t }}</a>
          <a href="{{ routes.search_url }}?q={{ q }}&type=product&options%5Bprefix%5D=last" class="blog-tags__tag"{% if is_products %} aria-current="page"{% endif %}>{{ 'templates.search.tab_products' | t }}</a>
          <a href="{{ routes.search_url }}?q={{ q }}&type=article,page&options%5Bprefix%5D=last" class="blog-tags__tag"{% if is_other %} aria-current="page"{% endif %}>{{ 'templates.search.tab_other' | t }}</a>
        </nav>
      {%- endif -%}
    </header>

    {%- if search.performed -%}
      {%- paginate search.results by section.settings.results_per_page -%}
        {%- if section.settings.enable_filtering and is_other == false -%}
          {% render 'facets', results: search, section_id: section.id, enable_sorting: true %}
        {%- else -%}
          <p class="facets__count" id="ProductCount" role="status">{{ 'templates.search.results_with_count' | t: terms: search.terms, count: search.results_count }}</p>
        {%- endif -%}

        <div id="ProductGridContainer" class="product-grid-container">
          {%- if search.results_count == 0 -%}
            <div class="collection-empty">
              <span class="collection-empty__icon">{% render 'icon', icon: 'search' %}</span>
              <p class="h3">{{ 'templates.search.no_results' | t: terms: search.terms }}</p>
              <p class="text-muted">{{ 'templates.search.no_results_hint' | t }}</p>
              <a href="{{ routes.all_products_collection_url }}" class="button button--secondary">{{ 'general.continue_shopping' | t }}</a>
            </div>
          {%- else -%}
            <ul class="grid" role="list" style="--cols: var(--user-cols, 4); --cols-tablet: var(--user-cols, 3); --cols-mobile: var(--user-cols-mobile, 2);">
              {%- for item in search.results -%}
                <li>
                  {%- case item.object_type -%}
                    {%- when 'product' -%}
                      {% render 'product-card', product: item, section_id: section.id %}
                    {%- when 'article', 'page' -%}
                      {%- assign result_type_key = 'templates.search.' | append: item.object_type -%}
                      <article class="search-result">
                        <p class="search-result__type">{{ result_type_key | t }}</p>
                        <h3 class="search-result__title"><a href="{{ item.url }}" class="search-result__link">{{ item.title | escape }}</a></h3>
                        {%- assign summary = item.excerpt | default: item.content | strip_html | truncatewords: 20 -%}
                        {%- if summary != blank -%}<p class="search-result__text">{{ summary }}</p>{%- endif -%}
                        <span class="search-result__more" aria-hidden="true">{% render 'icon', icon: 'arrow' %}</span>
                      </article>
                  {%- endcase -%}
                </li>
              {%- endfor -%}
            </ul>
            {% render 'pagination', paginate: paginate %}
          {%- endif -%}
        </div>
      {%- endpaginate -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.main_search.name",
  "tag": "div",
  "class": "section",
  "settings": [
    { "type": "range", "id": "results_per_page", "min": 8, "max": 36, "step": 4, "default": 16, "label": "t:sections.main_search.settings.results_per_page.label" },
    { "type": "checkbox", "id": "enable_filtering", "default": true, "label": "t:sections.main_collection.settings.enable_filtering.label" },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.color_scheme.label", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "t:sections.all.padding_top", "default": 48 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "t:sections.all.padding_bottom", "default": 72 }
  ]
}
{% endschema %}
