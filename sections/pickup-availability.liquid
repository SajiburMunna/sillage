{%- comment -%} Rendered via /variants/:id/?section_id=pickup-availability {%- endcomment -%}
{%- assign pick_up_availabilities = product_variant.store_availabilities | where: 'pick_up_enabled', true -%}

{%- if pick_up_availabilities.size > 0 -%}
  <div data-pickup-availability>
    {%- assign closest_location = pick_up_availabilities.first -%}
    <p style="display: flex; gap: 0.8rem; align-items: flex-start; margin: 0;">
      {% render 'icon', icon: 'pin' %}
      <span>
        {%- if closest_location.available -%}
          {{ 'products.product.pickup_availability.pick_up_available_at_html' | t: location_name: closest_location.location.name }}
          <br><span class="text-muted">{{ closest_location.pick_up_time }}</span>
        {%- else -%}
          {{ 'products.product.pickup_availability.pick_up_unavailable_at_html' | t: location_name: closest_location.location.name }}
        {%- endif -%}
        <br>
        <button type="button" class="link" data-pickup-open aria-controls="PickupDrawer" aria-haspopup="dialog">
          {%- if pick_up_availabilities.size == 1 -%}
            {{ 'products.product.pickup_availability.view_store_info' | t }}
          {%- else -%}
            {{ 'products.product.pickup_availability.check_other_stores' | t }}
          {%- endif -%}
        </button>
      </span>
    </p>

    <drawer-component id="PickupDrawer" class="drawer" role="dialog" aria-modal="true" aria-labelledby="PickupDrawer-Title">
      <button type="button" class="drawer__overlay" data-drawer-close tabindex="-1" aria-label="{{ 'accessibility.close' | t }}"></button>
      <div class="drawer__panel" tabindex="-1">
        <div class="drawer__header">
          <h2 class="drawer__title h3" id="PickupDrawer-Title">{{ product_variant.product.title | escape }}</h2>
          <button type="button" class="icon-button" data-drawer-close data-drawer-focus aria-label="{{ 'accessibility.close' | t }}">
            {% render 'icon', icon: 'close' %}
          </button>
        </div>
        <div class="drawer__body">
          {%- unless product_variant.product.has_only_default_variant -%}
            <p class="text-muted">{{ product_variant.title | escape }}</p>
          {%- endunless -%}
          <ul class="cart-items" role="list">
            {%- for availability in pick_up_availabilities -%}
              <li>
                <h3 class="h4">{{ availability.location.name | escape }}</h3>
                <p class="text-muted">
                  {%- if availability.available -%}
                    {{ 'products.product.pickup_availability.pick_up_available' | t }}, {{ availability.pick_up_time | downcase }}
                  {%- else -%}
                    {{ 'products.product.pickup_availability.pick_up_unavailable' | t }}
                  {%- endif -%}
                </p>
                {%- assign address = availability.location.address -%}
                <address style="font-style: normal;">
                  {{ address | format_address }}
                  {%- if address.phone.size > 0 -%}<p>{{ address.phone }}</p>{%- endif -%}
                </address>
              </li>
            {%- endfor -%}
          </ul>
        </div>
      </div>
    </drawer-component>
  </div>
{%- endif -%}
