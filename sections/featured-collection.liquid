{%- assign products_to_show = section.settings.products_to_show -%}
<section
  class="section-padding color-{{ section.settings.color_scheme }}"
  style="--pad-top: {{ section.settings.padding_top }}px; --pad-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="page-width">
    <div class="section-header" data-reveal>
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        <h2 class="section-header__title h-display h-display--md">{{ section.settings.heading }}</h2>
      </div>
      {%- if section.settings.description != blank -%}
        <div class="section-header__text rte">{{ section.settings.description }}</div>
      {%- endif -%}
    </div>

    <ul class="grid" role="list" style="--cols: {{ section.settings.columns_desktop }}; --cols-tablet: 3; --cols-mobile: {{ section.settings.columns_mobile }};">
      {%- if section.settings.collection != blank -%}
        {%- for product in section.settings.collection.products limit: products_to_show -%}
          <li>{% render 'product-card', product: product, section_id: section.id %}</li>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..products_to_show) -%}
          <li>{% render 'product-card', product: blank, placeholder_index: i %}</li>
        {%- endfor -%}
      {%- endif -%}
    </ul>

    {%- if section.settings.show_view_all and section.settings.collection != blank -%}
      <div class="text-center" style="margin-top: 4.8rem;">
        <a href="{{ section.settings.collection.url }}" class="button button--secondary">
          {{ 'sections.featured_collection.view_all' | t }}
          {% render 'icon', icon: 'arrow' %}
          <span class="visually-hidden">{{ section.settings.collection.title | escape }}</span>
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.featured_collection.name",
  "tag": "div",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "eyebrow", "default": "The collection", "label": "t:sections.all.eyebrow" },
    { "type": "inline_richtext", "id": "heading", "default": "Signature scents", "label": "t:sections.all.heading" },
    { "type": "richtext", "id": "description", "label": "t:sections.all.description" },
    { "type": "collection", "id": "collection", "label": "t:sections.featured_collection.settings.collection.label" },
    { "type": "range", "id": "products_to_show", "min": 2, "max": 16, "step": 1, "default": 4, "label": "t:sections.all.products_to_show" },
    { "type": "range", "id": "columns_desktop", "min": 2, "max": 5, "step": 1, "default": 4, "label": "t:sections.all.columns_desktop" },
    {
      "type": "select",
      "id": "columns_mobile",
      "default": "2",
      "label": "t:sections.all.columns_mobile",
      "options": [
        { "value": "1", "label": "t:sections.all.columns_mobile_options.one" },
        { "value": "2", "label": "t:sections.all.columns_mobile_options.two" }
      ]
    },
    { "type": "checkbox", "id": "show_view_all", "default": true, "label": "t:sections.featured_collection.settings.show_view_all.label" },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.color_scheme.label", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "t:sections.all.padding_top", "default": 96 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "t:sections.all.padding_bottom", "default": 96 }
  ],
  "presets": [{ "name": "t:sections.featured_collection.presets.name" }]
}
{% endschema %}
